# ==========================================================================
# CONFIGURACIÓN APACHE / LITESPEED PARA CPANEL COMPARTIDO - ISOTELI
# 1. Fuerza dominio canónico HTTPS sin www (https://isoteli.com)
# 2. Redirección 301 de rutas heredadas (/servicios -> /eventos)
# 3. Fallback dinámico para nuevos productos creados en WordPress Headless
# ==========================================================================

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirección 301 canónica: HTTP -> HTTPS y www -> sin www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://isoteli.com%{REQUEST_URI} [R=301,L]

  # Redirección 301 de ruta legada /servicios hacia /eventos
  RewriteRule ^servicios/?$ /eventos [R=301,L]

  # Si el producto fue creado en WordPress después del build estático,
  # sirve internamente la plantilla /detalle-producto/index.html conservando la URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^producto/([^/]+)/?$ /detalle-producto/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Asegura que el navegador valide siempre el HTML principal mientras cachea assets versionados
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
