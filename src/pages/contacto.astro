---
import Layout from '../layouts/Layout.astro';
import { AREQUIPA_DISTRICTS, ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import { PLACEHOLDER_IMAGE } from '../data/fallback-store';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';

const assurancePills = [
  { icon: 'schedule', title: 'Mismo Día', subtitle: 'Entrega de 1h a 3h' },
  { icon: 'local_florist', title: 'Flores Frescas', subtitle: 'Selección botánica del día' },
  { icon: 'verified', title: 'Foto Previa', subtitle: 'Control de calidad al 100%' },
  { icon: 'payments', title: 'Pagos Fáciles', subtitle: 'Transferencia, Yape y Plin' },
] as const;

const faqItems = [
  {
    icon: 'alarm_on',
    question: '¿Con cuánta anticipación debo hacer mi pedido?',
    answerHtml:
      'Atendemos <strong>pedidos inmediatos (mínimo 1 hora, máximo 3 horas)</strong> según disponibilidad de movilidad, lo cual se coordinará directamente con el cliente. También puedes programar tu entrega con anticipación para fechas especiales o ambientación integral de eventos.',
  },
  {
    icon: 'photo_camera',
    question: '¿Cómo sé cómo quedó mi arreglo antes de que lo entreguen?',
    answerHtml:
      '<strong>100% de transparencia:</strong> Una vez que nuestras floristas finalizan la creación y colocan tu dedicatoria, te enviamos una <em>fotografía y video en alta resolución por WhatsApp</em> (o realizamos una videollamada personalizada) para tu visto bueno antes de que el motorizado inicie la ruta de entrega.',
  },
  {
    icon: 'credit_card',
    question: '¿Cuáles son los métodos de pago aceptados?',
    answerHtml:
      'Aceptamos los siguientes métodos de pago: <strong>Transferencia bancaria</strong>, <strong>Yape</strong> y <strong>Plin</strong> al número oficial <strong>+51 904 803 219</strong>. Todos los pagos cuentan con validación y confirmación inmediata vía WhatsApp.',
  },
  {
    icon: 'explore',
    question: '¿Realizan decoraciones fuera de Arequipa ciudad?',
    answerHtml:
      '¡Sí! Nuestro equipo de montaje realiza ambientación de bodas de destino, aniversarios campestres y recepciones en el <strong>Valle del Colca, Camaná, Mollendo</strong> y clubes campestres en las afueras de Arequipa (Yarabamba, Sabandía, Characato). Contáctanos para cotizar la logística de tu locación.',
  },
] as const;

const atelierGallery = [
  {
    label: 'Rosas Silvestres',
    imageUrl:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuDnmy1nkl19B8MG8s_XXXJr-Neut8PeE7oWnxMjEIhVm1PbV7GSHsX09mlbqTIjQzyoO6cxwC3G2e8mkswI0J5nPZLKyqad-ev6PPHgU_xIsQAhU1GXIXxkjy7uIAYixJcSnzcCglJojltTJRfIt_3B-Ky5XNkQPf2AMb4mIIItnR2I0Bok8gjkqYTZ8hjbh0QinqBZu0JEnjpusqcHChqcTjUAIyu18M-TyPQGHMZ02KX1zKV4SY7Jag',
    alt: 'Rosas ecuatorianas color durazno y terracota atadas con cinta de seda en ISOTELI Arequipa',
  },
  {
    label: 'Cajas Exclusivas',
    imageUrl:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuDbC7DeMdGbsYXtFvsB-S8zSyyn79sLvZCq5YzOjI4u8f0-7QWXFbqCVEEkDlM-CyJ1LaU7imnRhbclH4co6BS1tiRcxttYUw_Fjln3GCEX-DWkdRHO56z3MXegGnoqA52SbKx6lWI0ZkitUKlCx_ftV_lhD-f1C6NY3XBZ5SW1s-nlicGYtpuXocpTnW86KmvI9Nr21KNcQjozXBGM1CqkEV7VV95Z6JNoPKC2HV21AsFxnll0iomdzQ',
    alt: 'Caja floral de lujo ISOTELI con hortensias frescas, rosas de jardín y eucalipto andino',
  },
  {
    label: 'Bodas & Eventos',
    imageUrl:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuAQ3Gx4RZTzIsZX7X_sfyFJweQu4VTbuPWfRdDJHXP80WD3n4cCybP6O6b9JcuZwv2C_VVul0ufTURBXgVhy98Y7EicLmnUUPn_PHV__H8vREwj2Tdlu8EJ0FFAA0EupAo-cFbm4q2vX-s2PCxD7aCEjFEvY607MCzE0KlFn5XHl2U_GMNOBM47Nv8ALvD8bv5mzCjOuxtIIbLYOszsdsRhvjgvI8LAzkksh7ur9teM-wHYzuKmAZ7z5g',
    alt: 'Centro de mesa floral con velas y arcos de sillar arequipeño para boda y evento especial',
  },
  {
    label: 'Packs de Regalo',
    imageUrl:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuCQgDrHhryjQbOgChJLwXvc0s1jDZI1n_EJvVciiVJXWiQ-q-ezhhIMNtIra4JFabNVog-qb6pvG5ECIzxptctJEiqKvA25ur3du-_dl1iwDOrZUKr7jMy1wzKL2pPH2iTcylh4oGvcqfK2thEKhron8FOQaLWBwnF5z5HpIGJ1a4w7g5XJsWKbwDJ2ne9ZWw8KOlmT2MRE_rYWPbByBkBS86v6wrhaUNFO7qISQqKsjydaN9HeZk0TNA',
    alt: 'Florista empacando chocolates La Ibérica, tarjeta caligrafiada y flores frescas para regalo en Arequipa',
  },
] as const;

const mapBackgroundUrl =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuB6kj4vLYKW_Igqr6ZhMiRdoROLV1XUkb7Yd8tfPbJZFINIv07c8h8OE9bWvTgqNx-EV4UzNrgIr3pUf1UevmdBT-NHOo6DfogUg29NstpMaYVXte4T_1vtV003EsdpeKJ-T885GQj7rrI1b9Y1qo89SNowReLIFt1xK71MtiyjR7X3WGOmfwcQh3Hii_4KI4dZL3C4AmKEEpzlPTGOTu_huRJiSDervnF-t2IAvHOMxAS_WA9sEevjcQ';

const promiseVignetteUrl =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCfeYSKaEgDCHVj1RflJp1NgUnBmCdKcAGCS0uO28QsInvKT8nqNsiR2lShFvLjK6FeCIP5-LFmqL8JG8Hnxl3CdLVJ-VJOv83YBF8Jcxph9Ihuy1-i87EwrjBsITAmsXeNKylYb4NTuLGBKJfSgN_wOUGuYGv55nwwq7f5sivWgeUkqRkAyVY8QpHeuEBDuHiKc2fSV0N_k0kG1MYxP47fsqw7DY5ngB4rgl3xiU4-GtslPsYCdayNkw';
---

<Layout
  title="Contacto & Pedidos | Cotización Floral y Cobertura en Arequipa"
  description="Cotiza tu arreglo floral o decoración de eventos en Arequipa con ISOTELI. Atención inmediata al WhatsApp +51 904 803 219, tienda 100% virtual y oficina de eventos en Urb. Santa María de Lambramani A15."
>
  <div class="flex flex-col w-full">
    <!-- ================= CABECERA EDITORIAL Y FRANJA DE GARANTÍAS ================= -->
    <section class="relative w-full px-margin-mobile md:px-margin mt-5 pt-5 pb-space-lg overflow-hidden">
      <div class="absolute -top-32 right-10 w-96 h-96 rounded-full bg-primary-fixed/50 blur-3xl pointer-events-none -z-10"></div>
      <div class="absolute top-48 -left-20 w-80 h-80 rounded-full bg-secondary-container/60 blur-3xl pointer-events-none -z-10"></div>

      <!-- Cintilla de Confianza Superior -->
      <div class="w-full bg-surface-container-low rounded-lg p-space-sm mb-space-lg shadow-sm border border-outline-variant/25">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter-mobile md:gap-gutter">
          {
            assurancePills.map((pill) => (
              <div class="flex items-center gap-space-xs p-2 rounded-DEFAULT bg-surface-container-lowest/80 backdrop-blur-sm border border-outline-variant/30">
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-secondary shrink-0">
                  <span class="material-symbols-outlined text-[20px]" aria-hidden="true">
                    {pill.icon}
                  </span>
                </div>
                <div class="flex flex-col min-w-0">
                  <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold truncate">
                    {pill.title}
                  </span>
                  <span class="font-body-sm text-body-sm text-on-surface-variant truncate">
                    {pill.subtitle}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Título Principal Editorial -->
      <div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-space-sm mb-space-lg">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-fixed text-primary font-label-md text-label-md uppercase tracking-widest shadow-sm">
          <span class="material-symbols-outlined icon-filled text-[15px]" aria-hidden="true">favorite</span>
          <span>Atelier Floral Boutique • Arequipa</span>
        </div>

        <h1 class="font-display-hero text-display-hero-mobile md:text-display-hero text-primary tracking-tight leading-tight">
          Hablemos de Flores &amp; <span class="italic font-light text-on-surface">Momentos Especiales</span>
        </h1>

        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl text-center leading-relaxed">
          Estamos listos para asesorarte con un diseño floral a medida, coordinar tu entrega express en Arequipa o planificar la ambientación escenográfica de tu próximo gran evento.
        </p>
      </div>
    </section>

    <!-- ================= SECCIÓN PRINCIPAL: CANALES DIRECTOS + FORMULARIO DE COTIZACIÓN ================= -->
    <section class="w-full px-margin-mobile md:px-margin pb-space-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <!-- COLUMNA IZQUIERDA (5 cols): Tarjetas de Contacto Directo y Oficina -->
        <div class="lg:col-span-6 flex flex-col gap-space-md">
          <!-- Tarjeta Prioritaria WhatsApp con Indicador Activo -->
          <div class="relative overflow-hidden rounded-lg bg-surface-container-low p-space-md shadow-[0_8px_24px_rgba(194,101,42,0.08)] flex flex-col gap-space-sm group border border-outline-variant/40">
            <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-primary-fixed/60 pointer-events-none"></div>
            <div class="flex items-center justify-between">
              <span class="font-label-md text-label-md uppercase tracking-widest text-primary font-semibold">
                Canal Prioritario Inmediato
              </span>
              <span class="relative flex h-3 w-3" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
              </span>
            </div>

            <div>
              <a
                class="w-full flex items-center justify-between px-space-md py-3.5 rounded-full bg-primary hover:bg-primary-container text-on-primary transition-all shadow-[0_8px_20px_rgba(194,101,42,0.28)] group-hover:scale-[1.01]"
                href={buildWhatsAppUrl('Hola ISOTELI, deseo hacer un pedido de flores')}
                rel="noopener noreferrer"
                target="_blank"
              >
                <div class="flex items-center gap-space-xs">
                  <WhatsAppIcon class="w-6 h-6 text-[#25D366]" />
                  <span class="font-label-lg text-label-lg tracking-wider">WhatsApp Ventas Directas</span>
                </div>
                <span class="font-headline-sm text-headline-sm font-semibold tracking-wide">
                  {ISOTELI_CONTACT.phoneShort}
                </span>
              </a>
            </div>
          </div>

          <!-- Tarjeta de Modalidad Virtual, Oficina Lambramani, Horarios y Correos -->
          <div class="rounded-lg bg-surface-container-low p-space-md shadow-[0_8px_24px_rgba(194,101,42,0.06)] flex flex-col gap-space-md border border-outline-variant/40">
            <div class="flex items-start gap-space-sm px-5">
              <div class="w-12 h-12 rounded-full bg-primary-fixed flex items-center justify-center text-primary shrink-0">
                <span class="material-symbols-outlined text-[24px]" aria-hidden="true">storefront</span>
              </div>
              <div class="flex flex-col">
                <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold">
                  Tienda Virtual &amp; Oficina de Eventos
                </span>
                <h2 class="font-headline-sm text-headline-sm text-primary">Boutique ISOTELI</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mt-1 leading-relaxed">
                  Al ser tienda 100% virtual sin local físico para muestras y ventas, todo el proceso es en línea (se pueden realizar videollamadas), y nuestra oficina exclusiva para coordinación y decoración de eventos es en:<br />
                  <span class="font-semibold text-on-surface">{ISOTELI_CONTACT.officeAddress}.</span>
                </p>
              </div>
            </div>

            <!-- Horarios de Atención -->
            <div class="rounded-DEFAULT bg-surface-container p-space-sm flex flex-col gap-2">
              <div class="flex items-center justify-between font-body-sm text-body-sm">
                <span class="font-medium text-on-surface flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">calendar_today</span>
                  Lunes a Sábado:
                </span>
                <span class="text-on-surface-variant font-semibold">8:00 AM - 8:00 PM</span>
              </div>
              <div class="flex items-center justify-between font-body-sm text-body-sm">
                <span class="font-medium text-on-surface flex items-center gap-2">
                  <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">schedule</span>
                  Domingos y Feriados:
                </span>
                <span class="text-on-surface-variant font-semibold">9:00 AM - 3:00 PM</span>
              </div>
              <div class="mt-1 pt-2 bg-primary-fixed/40 -mx-space-sm -mb-space-sm px-space-sm py-2 rounded-b-DEFAULT flex items-center gap-2 border-t border-outline-variant/30">
                <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">flare</span>
                <p class="font-body-sm text-body-sm text-on-surface">
                  <strong class="text-primary">Fechas Festivas:</strong> Guardias activas 24/7 en WhatsApp (San Valentín, Día de la Madre y Navidad).
                </p>
              </div>
            </div>

            <!-- Ecosistema de Correos Corporativos -->
            <div class="flex flex-col gap-space-xs pt-1">
              <span class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-semibold">
                Escríbenos por correo
              </span>
              <div class="flex flex-wrap gap-2">
                <a
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-primary-fixed text-primary font-body-sm text-body-sm transition-colors border border-outline-variant/30"
                  href={`mailto:${ISOTELI_CONTACT.emails.ventas}`}
                >
                  <span class="material-symbols-outlined text-[14px]" aria-hidden="true">mail</span>
                  {ISOTELI_CONTACT.emails.ventas}
                </a>
                <a
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-primary-fixed text-primary font-body-sm text-body-sm transition-colors border border-outline-variant/30"
                  href={`mailto:${ISOTELI_CONTACT.emails.eventos}`}
                >
                  <span class="material-symbols-outlined text-[14px]" aria-hidden="true">event</span>
                  {ISOTELI_CONTACT.emails.eventos}
                </a>
                <a
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-primary-fixed text-primary font-body-sm text-body-sm transition-colors border border-outline-variant/30"
                  href={`mailto:${ISOTELI_CONTACT.emails.administracion}`}
                >
                  <span class="material-symbols-outlined text-[14px]" aria-hidden="true">badge</span>
                  {ISOTELI_CONTACT.emails.administracion}
                </a>
              </div>
            </div>

            <!-- Redes Sociales -->
            <div class="flex items-center justify-between pt-2">
              <span class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-semibold">
                Comunidad ISOTELI
              </span>
              <div class="flex items-center gap-2">
                <a
                  aria-label="Instagram ISOTELI"
                  class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-all border border-outline-variant/30"
                  href="https://instagram.com"
                  rel="noopener noreferrer"
                  target="_blank"
                  title="Instagram"
                >
                  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">photo_camera</span>
                </a>
                <a
                  aria-label="WhatsApp Oficial ISOTELI"
                  class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-all border border-outline-variant/30"
                  href={buildWhatsAppUrl('Hola ISOTELI, vengo desde la web oficial')}
                  rel="noopener noreferrer"
                  target="_blank"
                  title={`WhatsApp: ${ISOTELI_CONTACT.phoneDisplay}`}
                >
                  <WhatsAppIcon class="w-[18px] h-[18px]" />
                </a>
              </div>
            </div>
          </div>

          <!-- Viñeta Garantía ISOTELI -->
          <div class="rounded-lg overflow-hidden bg-secondary-container/60 p-space-md relative flex items-center gap-space-sm border border-secondary/30">
            <div class="w-20 h-20 rounded-lg overflow-hidden shrink-0 shadow-sm">
              <img
                class="w-full h-full object-cover"
                src={promiseVignetteUrl}
                alt="Manos de florista artesanal preparando rosas frescas y eucalipto en taller de Arequipa"
                loading="lazy"
                onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
              />
            </div>
            <div class="flex flex-col">
              <span class="font-headline-sm text-headline-sm text-secondary font-semibold">Garantía ISOTELI</span>
              <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                Cada diseño se prepara minutos antes de su entrega. Si deseas algún tono especial o follaje andino particular, déjanos una nota.
              </p>
            </div>
          </div>
        </div>

        <!-- COLUMNA DERECHA (7 cols): Formulario Interactivo de Cotización Floral -->
        <div class="lg:col-span-6">
          <div class="rounded-lg bg-surface-container-lowest p-space-md md:p-space-lg shadow-[0_8px_24px_rgba(194,101,42,0.08)] relative border border-outline-variant/30 pl-5">
            <div class="flex flex-col gap-space-xs mb-space-md">
              <div class="flex items-center gap-2">
                <span class="w-6 h-0.5 bg-primary rounded-full"></span>
                <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold">
                  Cotización Rápida &amp; Personalizada
                </span>
              </div>
              <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary font-semibold">
                Diseñemos tu Arreglo o Evento
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Completa los detalles de tu solicitud. Al presionar el botón se generará tu ficha de pedido y podrás confirmar al instante por WhatsApp con nuestras floristas.
              </p>
            </div>

            <form
              class="flex flex-col gap-space-md"
              id="contactFloralForm"
              data-wa-phone={ISOTELI_CONTACT.phoneRaw}
            >
              <!-- Fila 1: Nombre y Celular -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter-mobile md:gap-gutter">
                <div class="flex flex-col gap-1.5">
                  <label
                    class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-semibold"
                    for="fullName"
                  >
                    Nombre Completo *
                  </label>
                  <div class="relative flex items-center">
                    <span class="material-symbols-outlined text-[18px] text-outline absolute left-3 pointer-events-none" aria-hidden="true">
                      person
                    </span>
                    <input
                      class="w-full pl-10 pr-4 py-3 rounded-full bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary shadow-sm border border-outline-variant/20"
                      id="fullName"
                      name="fullName"
                      placeholder="Ej. Camila Valdivia"
                      required
                      type="text"
                    />
                  </div>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label
                    class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-semibold"
                    for="phoneWhatsApp"
                  >
                    WhatsApp / Celular *
                  </label>
                  <div class="relative flex items-center">
                    <span class="material-symbols-outlined text-[18px] text-outline absolute left-3 pointer-events-none" aria-hidden="true">
                      phone
                    </span>
                    <input
                      class="w-full pl-10 pr-4 py-3 rounded-full bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary shadow-sm border border-outline-variant/20"
                      id="phoneWhatsApp"
                      name="phoneWhatsApp"
                      placeholder="Ej. 904 803 219"
                      required
                      type="tel"
                    />
                  </div>
                </div>
              </div>

              <!-- Fila 2: Tipo de Solicitud -->
              <div class="flex flex-col gap-1.5">
                <span class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-semibold">
                  ¿Qué tipo de diseño floral necesitas? *
                </span>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  <label class="cursor-pointer">
                    <input checked class="peer sr-only" name="requestType" type="radio" value="Arreglo Floral para Regalo" />
                    <div class="p-3 rounded-DEFAULT bg-surface-container-low text-center peer-checked:bg-primary peer-checked:text-on-primary transition-all flex flex-col items-center gap-1 border border-outline-variant/30">
                      <span class="material-symbols-outlined text-[20px]" aria-hidden="true">featured_seasonal_and_gifts</span>
                      <span class="font-body-sm text-body-sm font-medium leading-tight">Regalo o Cumpleaños</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input class="peer sr-only" name="requestType" type="radio" value="Decoración Integral de Evento" />
                    <div class="p-3 rounded-DEFAULT bg-secondary-container/60 text-secondary text-center peer-checked:bg-secondary peer-checked:text-on-secondary transition-all flex flex-col items-center gap-1 border border-secondary/30">
                      <span class="material-symbols-outlined text-[20px]" aria-hidden="true">celebration</span>
                      <span class="font-body-sm text-body-sm font-medium leading-tight">Boda o Fiesta</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input class="peer sr-only" name="requestType" type="radio" value="Alquiler de Mobiliario" />
                    <div class="p-3 rounded-DEFAULT bg-secondary-container/60 text-secondary text-center peer-checked:bg-secondary peer-checked:text-on-secondary transition-all flex flex-col items-center gap-1 border border-secondary/30">
                      <span class="material-symbols-outlined text-[20px]" aria-hidden="true">chair_alt</span>
                      <span class="font-body-sm text-body-sm font-medium leading-tight">Mobiliario</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
