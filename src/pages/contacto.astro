<!-- ================= SCRIPT CLIENTE MÍNIMO: FORMULARIO WHATSAPP Y ACORDEÓN FAQ ================= -->
<script>
  const contactForm = document.getElementById('contactFloralForm') as HTMLFormElement | null;
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const waPhone = contactForm.dataset.waPhone || '51904803219';

      const fullName = (document.getElementById('fullName') as HTMLInputElement | null)?.value.trim() ?? '';
      const phone = (document.getElementById('phoneWhatsApp') as HTMLInputElement | null)?.value.trim() ?? '';
      const requestTypeEl = document.querySelector<HTMLInputElement>('input[name="requestType"]:checked');
      const requestType = requestTypeEl ? requestTypeEl.value : 'Arreglo Floral para Regalo';
      const deliveryDate = (document.getElementById('deliveryDate') as HTMLInputElement | null)?.value ?? '';
      const districtSelect = (document.getElementById('districtSelect') as HTMLSelectElement | null)?.value ?? '';
      const notes = (document.getElementById('orderNotes') as HTMLTextAreaElement | null)?.value.trim() ?? '';

      const addonsNodes = document.querySelectorAll<HTMLInputElement>('input[name="addons"]:checked');
      const addons = Array.from(addonsNodes).map((cb) => cb.value);

      const lines = [
        '¡Hola ISOTELI Florería! Deseo cotizar mi pedido:',
        '',
        `*Cliente:* ${fullName}`,
        `*Teléfono:* ${phone}`,
        `*Tipo de Solicitud:* ${requestType}`,
        `*Fecha Requerida:* ${deliveryDate}`,
        `*Distrito / Modalidad:* ${districtSelect}`,
      ];

      if (addons.length > 0) {
        lines.push(`*Complementos:* ${addons.join(', ')}`);
      }
      if (notes) {
        lines.push(`*Detalles / Dedicatoria:* ${notes}`);
      }

      lines.push('', '¿Podrían confirmarme disponibilidad y catálogo para esta fecha? Muchas gracias.');

      const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(waUrl, '_blank', 'noopener,noreferrer');
    });
  }

  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
  faqItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
    const content = item.querySelector<HTMLElement>('.faq-content');
    const icon = item.querySelector<HTMLElement>('.faq-icon');
    if (!trigger || !content || !icon) return;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      faqItems.forEach((otherItem) => {
        const otherTrigger = otherItem.querySelector<HTMLButtonElement>('.faq-trigger');
        const otherContent = otherItem.querySelector<HTMLElement>('.faq-content');
        const otherIcon = otherItem.querySelector<HTMLElement>('.faq-icon');
        if (!otherTrigger || !otherContent || !otherIcon) return;

        otherTrigger.setAttribute('aria-expanded', 'false');
        otherContent.classList.remove('max-h-96');
        otherContent.classList.add('max-h-0');
        otherContent.style.maxHeight = '';
        otherIcon.classList.remove('rotate-180');
      });

      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        content.classList.remove('max-h-0');
        content.style.maxHeight = `${content.scrollHeight}px`;
        icon.classList.add('rotate-180');
      }
    });
  });
</script>

