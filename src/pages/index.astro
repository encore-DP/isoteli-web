---
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import OccasionsSection from '../components/OccasionsSection.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { ISOTELI_VALUES, buildWhatsAppUrl } from '../data/business';
import { PLACEHOLDER_IMAGE } from '../data/fallback-store';
import { getCatalogProducts, getServicesAndRentals } from '../lib/wp-graphql';
import { getWebSiteSchema } from '../lib/seo-schema';

const { products } = await getCatalogProducts();
const { classicPacks } = await getServicesAndRentals();

// Selección sin duplicados priorizando los productos reales publicados en WordPress
function pickUniqueProducts(preferred: readonly (typeof products)[number][], limit = 4) {
  const seen = new Set<string>();
  const result: (typeof products)[number][] = [];
  for (const item of [...preferred, ...products]) {
    if (item && !seen.has(item.slug)) {
      seen.add(item.slug);
      result.push(item);
      if (result.length >= limit) break;
    }
  }
  return result;
}

const wpOriginProducts = products.filter((p) => !p.id.startsWith('fb-'));

const collectionHighlights = pickUniqueProducts([
  ...wpOriginProducts,
  ...products.filter((p) => p.featuredOnHome === 'collection' || p.featuredOnHome === 'both'),
]);

const bestSellers = pickUniqueProducts([
  ...wpOriginProducts,
  ...products.filter((p) => p.featuredOnHome === 'bestseller' || p.featuredOnHome === 'both'),
]);

const trustItems = ISOTELI_VALUES.map((val) => ({
  icon: val.icon,
  title: val.title,
  subtitle: val.shortSubtitle,
}));

const testimonials = [
  {
    initials: 'VG',
    name: 'Valeria Guzmán',
    district: 'Cayma, Arequipa',
    avatarBg: 'bg-primary-fixed text-primary',
    quote:
      'El ramo para el aniversario de mis padres superó todas las expectativas. La frescura de las rosas y el empaque en terracota cálido con sello lacrado fue pura elegancia. Llegó puntualísimo a Cayma.',
  },
  {
    initials: 'MR',
    name: 'Mauricio Rivera',
    district: 'Yanahuara, Arequipa',
    avatarBg: 'bg-primary-fixed-dim/60 text-primary',
    quote:
      'Pedí a las 11:30 AM para el cumpleaños de mi novia y a las 2:00 PM ya estaba en su oficina en Yanahuara con los chocolates La Ibérica. La atención por WhatsApp al 904 803 219 fue impecable.',
  },
  {
    initials: 'CP',
    name: 'Claudia Paredes',
    district: 'J.L.B. y Rivero, Arequipa',
    avatarBg: 'bg-primary-fixed text-primary',
    quote:
      'Hicieron los centros de mesa para mi matrimonio civil. Tienen una sensibilidad botánica única, nada tradicional aburrido, todo súper silvestre, contemporáneo y con inspiración en el sillar arequipeño.',
  },
] as const;
---

<Layout
  title="Florería en Arequipa | Flores y Rosas a Domicilio | ISOTELI"
  description="Envío de flores y rosas a domicilio en Arequipa el mismo día. Arreglos florales, cajas y eventos con delivery gratis desde S/99.90. ¡Pide hoy por WhatsApp!"
  schema={getWebSiteSchema()}
>
  <div class="flex flex-col w-full">
    <!-- ================= SECCIÓN HERO CARRUSEL DINÁMICO (3 SLIDES) ================= -->
    <HeroCarousel products={products} decorationPacks={classicPacks} />

    <!-- ================= SECCIÓN FAVORITOS DE AREQUIPA (MÁS VENDIDOS) ================= -->
    <section class="w-full px-margin-mobile md:px-margin pt-space-xl pb-space-xl" data-aos="fade-up">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8" data-aos="fade-up">
        <div>
          <div class="inline-flex items-center gap-1.5 text-primary font-label-md text-label-md uppercase tracking-wider mb-1">
            <span class="material-symbols-outlined text-[16px]" aria-hidden="true">stars</span>
            <span>Los Más Solicitados</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Favoritos en Arequipa: Arreglos Más Pedidos</h2>
        </div>

        <div class="flex items-center gap-2">
          <a
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md tracking-wider shadow-sm hover:scale-105 transition-all"
            href={buildWhatsAppUrl('Hola ISOTELI, deseo hacer un pedido urgente para hoy')}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined text-[16px]" aria-hidden="true">bolt</span>
            <span>Entrega Hoy Mismo</span>
          </a>
        </div>
      </div>

      <div id="homeBestSellersGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {bestSellers.map((prod, idx) => (
          <div data-aos="fade-up" data-aos-delay={idx * 75}>
            <ProductCard product={prod} variant="featured" />
          </div>
        ))}
      </div>
    </section>
        
    <!-- ================= SECCIÓN COMPRAR POR OCASIÓN ================= -->
    <OccasionsSection />
        
    <!-- ================= BANNER DE SUSCRIPCIÓN Y CUPÓN 10% ================= -->
    <section class="w-full px-margin-mobile md:px-margin py-space-sm" data-aos="zoom-in">
      <div class="w-full bg-secondary text-on-secondary rounded-3xl p-6 sm:p-10 flex flex-col lg:flex-row items-center justify-between gap-6 shadow-md relative overflow-hidden">
        <div class="absolute right-0 top-0 bottom-0 opacity-10 pointer-events-none flex items-center pr-8" aria-hidden="true">
          <span class="material-symbols-outlined text-[180px]">local_florist</span>
        </div>

        <div class="flex items-center gap-4 text-left z-10">
          <div class="w-14 h-14 rounded-2xl bg-secondary-container text-secondary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[28px]" aria-hidden="true">redeem</span>
          </div>
          <div class="flex flex-col">
            <span class="font-headline-sm text-headline-sm font-bold text-on-secondary">
              10% DE DESCUENTO EN TU PRIMER PEDIDO
            </span>
            <span class="font-body-sm text-body-sm text-on-secondary/90">
              Únete a nuestra lista exclusiva de Arequipa y recibe novedades, fechas especiales y promociones.
            </span>
          </div>
        </div>

        <form id="home-subscribe-form" class="w-full lg:max-w-md z-10 flex flex-col gap-2">
          <div class="relative flex items-center bg-surface-container-lowest rounded-full p-1.5 shadow-inner">
            <label for="home-subscribe-email" class="sr-only">Correo electrónico</label>
            <input
              id="home-subscribe-email"
              class="w-full pl-5 pr-28 py-2.5 bg-transparent text-on-surface font-body-md text-body-md focus:outline-none placeholder:text-on-surface-variant/60"
              placeholder="Ingresa tu correo electrónico..."
              required
              type="email"
            />
            <button
              class="absolute right-1.5 bg-secondary hover:bg-secondary-container text-on-secondary hover:text-secondary font-label-md text-label-md px-5 py-2.5 rounded-full uppercase tracking-wider transition-colors shrink-0 cursor-pointer"
              type="submit"
            >
              Suscribir
            </button>
          </div>
          <div
            id="home-subscribe-success"
            class="hidden text-secondary-container font-label-md text-label-md px-3 items-center gap-1.5"
          >
            <span class="material-symbols-outlined text-[16px]" aria-hidden="true">check_circle</span>
            <span>¡Gracias! Usa el cupón <strong>BIENVENIDOISOTELI</strong> al pedir por WhatsApp.</span>
          </div>
        </form>
      </div>
    </section>

    <!-- ================= RESEÑAS DE CLIENTES EN AREQUIPA ================= -->
    <section class="w-full px-margin-mobile md:px-margin pb-space-xl" data-aos="fade-up">
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12">
        <div class="text-center max-w-xl mx-auto mb-10" data-aos="fade-up">
          <div class="flex items-center justify-center gap-1 text-primary mb-2" aria-label="Calificación de 5 estrellas">
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Voces de Nuestra Comunidad en Arequipa</h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Entregas puntuales, frescura garantizada y sonrisas compartidas en toda la Ciudad Blanca.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            testimonials.map((rev, idx) => (
              <div
                class="bg-surface-container-lowest p-6 rounded-2xl flex flex-col justify-between gap-4 shadow-sm"
                data-aos="fade-up"
                data-aos-delay={idx * 100}
              >
                <p class="font-body-md text-body-md text-on-surface italic">"{rev.quote}"</p>
                <div class="flex items-center gap-3">
                  <div
                    class:list={[
                      'w-10 h-10 rounded-full flex items-center justify-center font-bold font-headline-sm',
                      rev.avatarBg,
                    ]}
                  >
                    {rev.initials}
                  </div>
                  <div class="flex flex-col">
                    <span class="font-label-lg text-label-lg font-semibold text-on-surface">{rev.name}</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">{rev.district}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { syncHomePage } from '../lib/live-cms-sync';

  void syncHomePage();

  const subForm = document.getElementById('home-subscribe-form');
  const subSuccess = document.getElementById('home-subscribe-success');
  if (subForm && subSuccess) {
    subForm.addEventListener('submit', (e) => {
      e.preventDefault();
      subSuccess.classList.remove('hidden');
      subSuccess.classList.add('flex');
    });
  }
</script>
