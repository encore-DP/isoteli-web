    </section>

    <!-- ================= RESEÑAS DE CLIENTES EN AREQUIPA ================= -->
    <section class="w-full px-margin-mobile md:px-margin pb-space-xl">
      <div class="bg-surface-container-low rounded-3xl p-8 sm:p-12">
        <div class="text-center max-w-xl mx-auto mb-10">
          <div class="flex items-center justify-center gap-1 text-primary mb-2" aria-label="Calificación de 5 estrellas">
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
            <span class="material-symbols-outlined icon-filled text-[20px]" aria-hidden="true">star</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Voces de Nuestra Comunidad</h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Entregas puntuales, frescura garantizada y sonrisas compartidas en toda la Ciudad Blanca.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            testimonials.map((rev) => (
              <div class="bg-surface-container-lowest p-6 rounded-2xl flex flex-col justify-between gap-4 shadow-sm">
                <p class="font-body-md text-body-md text-on-surface italic">"{rev.quote}"</p>
                <div class="flex items-center gap-3">
                  <div
                    class:list={[
                      'w-10 h-10 rounded-full flex items-center justify-center font-bold font-headline-sm',
                      rev.avatarBg,
                    ]}
                  >
                    {rev.initials}
                  </div>
                  <div class="flex flex-col">
                    <span class="font-label-lg text-label-lg font-semibold text-on-surface">{rev.name}</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">{rev.district}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { syncHomePage } from '../lib/live-cms-sync';

  void syncHomePage();

  const subForm = document.getElementById('home-subscribe-form');
  const subSuccess = document.getElementById('home-subscribe-success');
  if (subForm && subSuccess) {
    subForm.addEventListener('submit', (e) => {
      e.preventDefault();
      subSuccess.classList.remove('hidden');
      subSuccess.classList.add('flex');
    });
  }
</script>
