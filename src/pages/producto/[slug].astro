---
import Layout from '../../layouts/Layout.astro';
import ProductDetailView from '../../components/ProductDetailView.astro';
import { getCatalogProducts, type CatalogProduct } from '../../lib/wp-graphql';
import { getProductSchema, getBreadcrumbSchema, resolveSeoImageUrl, SITE_URL } from '../../lib/seo-schema';

export async function getStaticPaths() {
  const { products } = await getCatalogProducts();

  return products.map((product) => {
    const sameCategory = products.filter(
      (item) => item.slug !== product.slug && item.categorySlug === product.categorySlug,
    );
    const otherCategories = products.filter(
      (item) => item.slug !== product.slug && item.categorySlug !== product.categorySlug,
    );
    const relatedProducts = [...sameCategory, ...otherCategories].slice(0, 4);

    return {
      params: { slug: product.slug },
      props: { product, relatedProducts },
    };
  });
}

interface Props {
  product: CatalogProduct;
  relatedProducts: readonly CatalogProduct[];
}

const { product, relatedProducts } = Astro.props;

const canonicalUrl = `${SITE_URL}/producto/${product.slug}/`;

// Título SEO optimizado (≤ 60 caracteres)
const fullSeoTitle = `${product.name} en Arequipa | Florería ISOTELI`;
const mediumSeoTitle = `${product.name} en Arequipa | ISOTELI`;
const pageTitle =
  fullSeoTitle.length <= 60
    ? fullSeoTitle
    : mediumSeoTitle.length <= 60
      ? mediumSeoTitle
      : `${product.name.slice(0, 49).trim()} | ISOTELI`;

// Meta descripción adaptada semánticamente a la categoría real (≤ 155 caracteres)
function buildProductMetaDescription(p: CatalogProduct): string {
  const prefix = `Pide ${p.name} en Arequipa desde ${p.formattedPrice}.`;
  let detail = 'Arreglo floral fresco con entrega a domicilio el mismo día.';
  if (p.categorySlug === 'globos-y-bouquets') {
    detail = 'Bouquet personalizado con globos y entrega a domicilio hoy mismo.';
  } else if (p.categorySlug === 'chocolates') {
    detail = 'Regalo con chocolates selectos y entrega a domicilio hoy mismo.';
  } else if (p.categorySlug === 'peluches-y-detalles') {
    detail = 'Detalle sorpresa a domicilio en Arequipa el mismo día.';
  } else if (p.categorySlug === 'cajas-y-boxes') {
    detail = 'Box floral exclusivo con flores frescas y envío hoy a domicilio.';
  }
  const full = `${prefix} ${detail} ¡Cotiza por WhatsApp!`;
  return full.length <= 155 ? full : `${prefix} ${detail}`.slice(0, 155);
}

const pageDescription = buildProductMetaDescription(product);
const seoOgImage = resolveSeoImageUrl(product.imageUrl);

const productSchemas = [
  getProductSchema(product, canonicalUrl, pageDescription),
  getBreadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Catálogo Floral', path: '/catalogo' },
    { name: product.name, path: `/producto/${product.slug}` },
  ]),
];
---

<!-- ================= PÁGINA DINÁMICA DE DETALLE DE PRODUCTO (WPGRAPHQL) ================= -->
<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={seoOgImage}
  canonicalPath={`/producto/${product.slug}`}
  schema={productSchemas}
>
  <ProductDetailView product={product} relatedProducts={relatedProducts} />
</Layout>
