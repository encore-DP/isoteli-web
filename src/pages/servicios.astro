---
import Layout from '../layouts/Layout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServicePackCard from '../components/ServicePackCard.astro';
import FurnitureRentalItem from '../components/FurnitureRentalItem.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import { PLACEHOLDER_IMAGE } from '../data/fallback-store';
import { getServicesAndRentals } from '../lib/wp-graphql';

const { classicPacks, thematicPacks, rentals } = await getServicesAndRentals();

// Separación visual para el mosaico panorámico de Línea Temática (Fila 2: 2 tarjetas; Fila 3: panorámica)
const thematicRowPacks = thematicPacks.filter((p) => p.variant !== 'panoramic');
const thematicPanoramicPacks = thematicPacks.filter((p) => p.variant === 'panoramic');

const serviceTrustItems = [
  { icon: 'verified', title: '100% Flor Fresca', subtitle: 'Selección diaria prémium' },
  { icon: 'architecture', title: 'Diseño a Medida', subtitle: 'Moodboard botánico exclusivo' },
  { icon: 'local_shipping', title: 'Montaje In-Situ', subtitle: 'Cobertura en todo Arequipa' },
  { icon: 'forum', title: 'Asesoría Directa', subtitle: 'Atención 1 a 1 vía WhatsApp' },
] as const;

const processSteps = [
  {
    step: '01',
    title: 'Consulta & Moodboard',
    description:
      'Escuchamos tus ideas, locación, paleta de color deseada y presupuesto para construir un tablero conceptual visual único.',
    footerIcon: 'lightbulb',
    footerLabel: 'Ideación a medida',
  },
  {
    step: '02',
    title: 'Propuesta Floral',
    description:
      'Te entregamos un presupuesto detallado, especificación de flores por variedad y muestra de mobiliario o estructuras accesorias.',
    footerIcon: 'check',
    footerLabel: 'Cotización clara',
  },
  {
    step: '03',
    title: 'Flores Frescas',
    description:
      'Selección rigurosa de flores y follajes recién cortados, cuidando la hidratación y punto óptimo de apertura para el día D.',
    footerIcon: 'eco',
    footerLabel: 'Frescura garantizada',
  },
  {
    step: '04',
    title: 'Montaje In-Situ',
    description:
      'Nuestro equipo se traslada con horas de anticipación a tu local en Arequipa para supervisar cada arreglo y escenografía.',
    footerIcon: 'location_on',
    footerLabel: 'Puntualidad total',
  },
] as const;

const occasionServices = [
  {
    category: 'cumpleanos',
    badge: 'Celebración',
    icon: 'celebration',
    title: 'Cumpleaños',
    description:
      'Decoración integral con backings personalizados, arcos orgánicos de globos, flores naturales y letreros luminosos adaptados a cualquier edad y estilo.',
    bullets: [
      'Packs Clásicos desde S/ 150.00',
      'Packs Temáticos infantiles desde S/ 250.00',
      'Mobiliario y backing personalizado incluido',
    ],
    ctaLabel: 'Cotizar Cumpleaños',
    waText: 'Hola ISOTELI, quisiera cotizar la decoración para Cumpleaños',
    image:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuAxvs2M_DTUsTbJw9mQEhU1bApDVNi8dx1LAHh-JPGuzAgvK-t-TWbuwLtRMbfN_xxVLZD5cVvdTXob75yV3W5h-492c_q9ee6-CN5EeIejapcNfVAxfbBpSXOe-p73Vh0qjvmB_WiiJVfkuSoAN-Qlst1fIOpU2yGzpyvRCO85PeYyCeeDnhOl7SpwnGKA39gyutJfhlw-Gd3PKXjMBy9_uqX8NT7llxAJgj_F-_eE1Jm_BQczWZd6iw',
    alt: 'Decoración floral y arcos orgánicos de globos para cumpleaños en Arequipa',
  },
  {
    category: 'bautizos',
    badge: 'Ceremonial',
    icon: 'spa',
    title: 'Bautizos',
    description:
      'Diseño sutil en tonos blanco, marfil y follaje andino. Arreglos para pila bautismal, recepción familiar y detalles botánicos que transmiten paz y elegancia.',
    bullets: [
      'Arreglos para iglesia o capilla privada',
      'Mesa de honor con flores y candelabros',
      'Recuerdos botánicos para padrinos e invitados',
    ],
    ctaLabel: 'Cotizar Bautizo',
    waText: 'Hola ISOTELI, quisiera cotizar la decoración para Bautizo',
    image:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuCMJP-jdxndFW-HJqDVt_dtKrB_FeWq_l9y3qHdr0uFTpxUVHWVQRNscyuDNu_RBkFMGI1xt35XWb88DeULr0SCOni8Lu8ZweItJwrPRTRNl23SwkIiFtz65b0GlQFdV1a_qdoK7237V6L2fnl_qr2Mzstg2KfoRzMqSIUoebTk6eIldZIWEns3iq_AMNkucovxe7UhdX0CAGIn2pAiWWMcna1gm8puQqlhnAxDW8nGcrGgEmmvlsWclQ',
    alt: 'Ambientación de bautizo con flores blancas y detalles ceremoniales en Arequipa',
  },
  {
    category: 'revelacion',
    badge: 'Maternidad & Familia',
    icon: 'child_care',
    title: 'Revelación de Género',
    description:
      'Montajes enternecedores en paletas pastel, estructuras cilíndricas, cubos BABY, cajas sorpresa con flores y globos con helio para el momento más esperado.',
    bullets: [
      'Estructuras pastel y cilindros temáticos',
      'Caja o globo gigante para la revelación',
      'Arreglos botánicos en bases cerámicas',
    ],
    ctaLabel: 'Cotizar Revelación de Género',
    waText: 'Hola ISOTELI, deseo cotizar Revelación de Género',
    image:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBwmAKYi-h19ERTOeoAOQexPvQ3uvS_RyRH17Zbta1QN8mafA1WDiLRSvLbPCLsCABVZUVWaQ1ovzqKN6tX3YHR04etP96o06bYBfId2JgLmM3weix92uLRjriuW5tdq9a91792BLvEiwIAKel2sGavVibMljGLqwvc6es6esHQ3AShImpOh83QRNQoeXzKYpIlUgp9LzyzzaQQQRLUVOUdQIwRLmzJe_x-oUWZM4mRDD783Y9DMc_Dqw',
    alt: 'Escenografía en tonos pastel y cubos decorativos para revelación de género',
  },
  {
    category: 'comunion',
    badge: 'Primera Comunión',
    icon: 'verified',
    title: 'Primera Comunión',
    description:
      'Decoración armónica y cálida con flores frescas, detalles en trigo silvestre, eucalipto, velas aromáticas y backdrops naturales para celebrar en familia.',
    bullets: [
      'Centros de mesa con espigas y flores blancas',
      'Mesa de dulces y recuerdos personalizada',
      'Espacio fotográfico familiar con follaje natural',
    ],
    ctaLabel: 'Cotizar Primera Comunión',
    waText: 'Hola ISOTELI, quisiera cotizar Primera Comunión',
    image:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuCwTtcABj-oAI3DSAAEnE724neyGExfsJyY2VFDcAzbpqHok_h9ohpSuI81eyn0Wkdobqrtx5V-vEpe6e1OfJmRCnV6F4fdP_JAXRo8jpEo_KNvIrvMtXvvks1AS2CneSMXEs9x4Q-tKHPxkNmRYqhTNmyzmiAj7hbrY5EbDucTnHYgn4JmvhNQ7MUcEqRpEslRjQh2vZMn9wtn6TNEzK4cXvd7uaiNZRXMW96SPlwe0BHDp3jXD28-Vg',
    alt: 'Decoración campestre elegante con flores frescas para Primera Comunión',
  },
  {
    category: 'pedidas',
    badge: 'Romance & Pedidas',
    icon: 'diamond',
    title: 'Pedidas de Mano',
    description:
      'Ambientación íntima a la luz de las velas con caminos de pétalos, rosas prémium, frases LED cálidas y montaje sorpresa para un "Sí" soñado.',
    bullets: [
      'Camino guiado con pétalos de rosa y candelabros',
      'Letrero luminoso "Marry Me" o iniciales LED',
      'Ramo bouquet de rosas de entrega sorpresa',
    ],
    ctaLabel: 'Planear Pedida de Mano',
    waText: 'Hola ISOTELI, deseo planear una Pedida de Mano',
    image:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuANowrAYOkPWH3716QIQ35SreMEuzZjjymf5oLpf8whs1kzINRMwt9COWb7HRB0fu9ry_h6dJupWtbT5aB8b6OaK1na5x6ZL53TvL5Z5pviA33ffbVTpF1hyBjkbdR7SvN2orPVS23dZpaktDgTwOUXLJ5lYVGl4ToPQHEfeClcU502LWBhBAVl_eV0u3WR2MB0AtOEJMygGUSu6YQ7-fSEbTJwV1pWBFvpNwZ7lFNAfgvxc_S0A6WBtg',
    alt: 'Escenografía romántica con pétalos y velas para pedida de mano en Arequipa',
  },
] as const;
---

<Layout
  title="Servicios de Decoración & Alquiler de Mobiliario"
  description="Paquetes de decoración de eventos en Arequipa (Línea Clásica desde S/ 150 y Línea Temática Infantil desde S/ 250) y alquiler de mobiliario y accesorios."
>
  <div class="flex flex-col w-full">
    <!-- ================= FRANJA SUPERIOR DE GARANTÍAS DE EVENTOS ================= -->
    <TrustStrip items={serviceTrustItems} variant="fullbleed" />

    <!-- ================= SECCIÓN HERO Y CANALES DE COORDINACIÓN DE EVENTOS ================= -->
    <section class="w-full px-margin-mobile md:px-margin pt-6 pb-space-lg" data-aos="fade-up">
      <div class="max-w-7xl mx-auto bg-surface-container-low rounded-xl p-6 sm:p-10 border border-outline-variant/30 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 flex flex-col gap-4" data-aos="fade-right">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-fixed text-primary font-label-md text-label-md uppercase tracking-widest w-max">
              <span class="material-symbols-outlined text-[16px]" aria-hidden="true">event_available</span>
              <span>Cotizador &amp; Asesoría Personalizada</span>
            </div>

            <h1 class="font-headline-lg text-headline-lg text-primary font-bold leading-tight">
              Cotiza la Ambientación para tu Celebración
            </h1>

            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Diseñamos y montamos la escenografía perfecta para nuestros 5 servicios exclusivos: <strong class="text-primary">Cumpleaños, Bautizos, Revelación de Género, Primera Comunión y Pedidas de Mano</strong>.
            </p>

            <div class="bg-surface-container-lowest p-4 rounded-lg border-l-4 border-primary flex flex-col gap-1 shadow-sm">
              <div class="flex items-center gap-2 text-primary font-label-md text-label-md font-semibold">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">storefront</span>
                <span>Modalidad Virtual y Oficina de Coordinación</span>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant">
                Al ser tienda 100% virtual sin local físico para muestras y ventas, todo se gestiona en línea (con posibilidad de videollamadas), y la coordinación presencial para eventos se realiza en nuestra oficina: <strong class="text-on-surface">{ISOTELI_CONTACT.officeAddress}</strong>.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <div class="flex items-start gap-2 bg-surface-container px-3.5 py-2.5 rounded-DEFAULT">
                <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" aria-hidden="true">schedule</span>
                <div>
                  <span class="font-label-md text-label-md text-primary block font-semibold">
                    Tiempos de Coordinación
                  </span>
                  <span class="font-body-sm text-body-sm text-on-surface-variant">
                    Pedidos inmediatos (mín 1 h, máx 3 h) para detalles; eventos coordinados con anticipación.
                  </span>
                </div>
              </div>

              <div class="flex items-start gap-2 bg-surface-container px-3.5 py-2.5 rounded-DEFAULT">
                <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" aria-hidden="true">payments</span>
                <div>
                  <span class="font-label-md text-label-md text-primary block font-semibold">
                    Métodos de Pago
                  </span>
                  <span class="font-body-sm text-body-sm text-on-surface-variant">
                    Transferencia bancaria, Yape y Plin.
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 bg-surface-container-lowest p-6 sm:p-8 rounded-xl shadow-md flex flex-col gap-5 border border-outline-variant/30" data-aos="fade-left">
            <h2 class="font-headline-sm text-headline-sm text-primary font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[22px]" aria-hidden="true">support_agent</span>
              <span>Canales Oficiales para Eventos</span>
            </h2>

            <div class="flex flex-col gap-3 font-body-sm text-body-sm text-on-surface-variant">
              <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low border border-outline-variant/20">
                <WhatsAppIcon class="w-5 h-5 text-[#25D366]" />
                <div>
                  <span class="font-label-md text-label-md text-secondary uppercase block font-semibold">
                    WhatsApp de Coordinación
                  </span>
                  <a
                    class="font-semibold text-primary hover:underline text-[15px]"
                    href={buildWhatsAppUrl('Hola ISOTELI, deseo cotizar un servicio de decoración')}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {ISOTELI_CONTACT.phoneDisplay}
                  </a>
                </div>
              </div>

              <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low border border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-[20px]" aria-hidden="true">mail</span>
                <div>
                  <span class="font-label-md text-label-md text-secondary uppercase block font-semibold">
                    Correos de Contacto
                  </span>
                  <div class="flex flex-col">
                    <a
                      class="hover:text-primary transition-colors font-medium"
                      href={`mailto:${ISOTELI_CONTACT.emails.eventos}`}
                    >
                      {ISOTELI_CONTACT.emails.eventos}
                    </a>
                    <a
                      class="hover:text-primary transition-colors font-medium"
                      href={`mailto:${ISOTELI_CONTACT.emails.ventas}`}
                    >
                      {ISOTELI_CONTACT.emails.ventas}
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <a
              class="w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-container text-on-primary py-3.5 px-6 rounded-full font-label-lg text-label-lg tracking-wider transition-all duration-300 shadow-md hover:shadow-lg"
              href={buildWhatsAppUrl('Hola ISOTELI, quisiera agendar una coordinación para un evento')}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">send</span>
              <span>Contactar por WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PACKS DE DECORACIÓN (WOOCOMMERCE: SERVICIOS-DECORACION) ================= -->
    <section
      class="w-full py-space-xl bg-surface-container-low/70 border-y border-outline-variant/30"
      id="paquetes-decoracion"
      data-aos="fade-up"
    >
      <div class="w-full px-margin-mobile md:px-margin">
        <!-- Encabezado y Pestañas de Línea Clásica / Temática -->
        <div class="max-w-4xl mx-auto text-center mb-10" data-aos="fade-up">
          <span class="font-label-md text-label-md uppercase tracking-widest text-primary font-bold inline-block mb-1">
            Paquetes de Ambientación ISOTELI
          </span>
          <h2 class="font-headline-lg text-headline-lg text-primary font-bold mt-1">
            Planes &amp; Paquetes de Decoración
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-2 max-w-2xl mx-auto">
            Soluciones completas y escalables para Cumpleaños, Bautizos, Revelación de Género, Primera Comunión y Pedidas de Mano.
          </p>

          <div class="inline-flex items-center gap-2 mt-4 px-4 py-1.5 rounded-full bg-surface-container text-primary font-label-md text-label-md border border-outline-variant/30 font-semibold shadow-sm">
            <span class="material-symbols-outlined text-[17px] text-secondary" aria-hidden="true">info</span>
            <span>Incluye mobiliario y accesorios • No incluye movilidad</span>
          </div>

          <!-- Filtro rápido por Línea de Paquetes -->
          <div class="flex flex-wrap items-center justify-center gap-2 mt-6">
            <button
              type="button"
              data-pack-line-btn="all"
              class="px-4 py-2 rounded-full font-label-md text-label-md bg-primary text-on-primary shadow-sm transition-colors cursor-pointer"
            >
              Todas las Líneas ({classicPacks.length + thematicPacks.length})
            </button>
            <button
              type="button"
              data-pack-line-btn="linea-clasica"
              class="px-4 py-2 rounded-full font-label-md text-label-md bg-surface-container text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
            >
              Línea Clásica ({classicPacks.length})
            </button>
            <button
              type="button"
              data-pack-line-btn="linea-tematica-infantil"
              class="px-4 py-2 rounded-full font-label-md text-label-md bg-surface-container text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
            >
              Línea Temática Infantil / Baby ({thematicPacks.length})
            </button>
          </div>
        </div>

        <!-- Mosaico Modular Dinámico: Línea Clásica y Línea Temática Infantil -->
        <div class="max-w-7xl mx-auto flex flex-col gap-4">
          <!-- Subcategoría: linea-clasica -->
          <div data-pack-group="linea-clasica" class="grid grid-cols-1 md:grid-cols-12 gap-4">
            {classicPacks.map((pack) => <ServicePackCard pack={pack} />)}
          </div>

          <!-- Subcategoría: linea-tematica-infantil -->
          <div data-pack-group="linea-tematica-infantil" class="flex flex-col gap-4">
            {
              thematicRowPacks.length > 0 && (
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                  {thematicRowPacks.map((pack) => (
                    <ServicePackCard pack={pack} />
                  ))}
                </div>
              )
            }
            {
              thematicPanoramicPacks.length > 0 && (
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                  {thematicPanoramicPacks.map((pack) => (
                    <ServicePackCard pack={pack} />
                  ))}
                </div>
              )
            }
          </div>
        </div>

        <!-- ================= ALQUILER DE MOBILIARIO (WOOCOMMERCE: ALQUILER-DE-MOBILIARIO) ================= -->
        <div class="mt-14 max-w-7xl mx-auto" id="alquiler-mobiliario">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-2 border-b border-outline-variant/30">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[24px]" aria-hidden="true">chair</span>
              <h3 class="font-headline-sm text-headline-sm text-primary font-bold">
                Alquiler de Mobiliario y Accesorios Individuales
              </h3>
            </div>
            <span class="text-body-sm text-on-surface-variant font-medium">
              Precios unitarios o por juego
            </span>
          </div>

          <div id="rentalsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {rentals.map((rental) => <FurnitureRentalItem item={rental} />)}

            <!-- Tarjeta Estática Final de Llamada a la Acción para Combinar Mobiliario -->
            <div
              data-static-rental-cta
              class="bg-primary-fixed/40 p-4 rounded-lg border border-primary/20 flex items-center justify-between gap-3"
            >
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-[24px] shrink-0" aria-hidden="true">info</span>
                <div>
                  <span class="font-semibold text-primary block text-[14px]">
                    ¿Deseas combinar mobiliario?
                  </span>
                  <span class="text-[12px] text-on-surface-variant">
                    Cotizamos paquetes a medida por WhatsApp
                  </span>
                </div>
              </div>
              <a
                class="px-3.5 py-1.5 rounded-full bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md tracking-wider font-semibold transition-colors shrink-0"
                href={buildWhatsAppUrl('Hola ISOTELI, deseo alquilar y combinar mobiliario adicional para mi evento')}
                rel="noopener noreferrer"
                target="_blank"
              >
                Consultar
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= METODOLOGÍA ISOTELI EN 4 PASOS ================= -->
    <section class="w-full bg-surface py-space-xl px-margin-mobile md:px-margin border-b border-outline-variant/30" data-aos="fade-up">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16" data-aos="fade-up">
          <span class="font-label-md text-label-md uppercase tracking-widest text-primary font-bold">
            Metodología ISOTELI
          </span>
          <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold mt-1">
            Cómo Creamos la Magia de tu Evento
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-3">
            Un proceso minucioso y transparente desde la primera idea hasta el último pétalo colocado en tu recepción.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
          {
            processSteps.map((st, idx) => (
              <div
                class="bg-surface-container-lowest p-6 rounded-lg flex flex-col justify-between shadow-sm relative group hover:-translate-y-1 transition-transform border border-outline-variant/30"
                data-aos="fade-up"
                data-aos-delay={idx * 80}
              >
                <div>
                  <div class="flex items-center justify-between mb-6">
                    <span class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container font-bold flex items-center justify-center font-headline-sm text-headline-sm">
                      {st.step}
                    </span>
                  </div>
                  <h3 class="font-headline-sm text-headline-sm text-primary font-semibold mb-2">
                    {st.title}
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    {st.description}
                  </p>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center text-primary font-label-md text-label-md">
                  <span class="material-symbols-outlined text-[15px] mr-1" aria-hidden="true">
                    {st.footerIcon}
                  </span>
                  <span>{st.footerLabel}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= GALERÍA DE MONTAJES REALIZADOS EN AREQUIPA ================= -->
