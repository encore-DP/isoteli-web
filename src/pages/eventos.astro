---
import Layout from '../layouts/Layout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServicePackCard from '../components/ServicePackCard.astro';
import FurnitureRentalItem from '../components/FurnitureRentalItem.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { Image } from 'astro:assets';
import { ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import { PLACEHOLDER_IMAGE } from '../data/fallback-store';
import { getServicesAndRentals } from '../lib/wp-graphql';
import { getBreadcrumbSchema, getEventsServiceSchema } from '../lib/seo-schema';
import eventoCumpleanosImg from '../assets/images/eventos/cumpleaños.jpg';
import eventoBautizoImg from '../assets/images/eventos/bautizo.jpg';
import eventoGeneroImg from '../assets/images/eventos/genero.jpg';
import eventoComunionImg from '../assets/images/eventos/primera_comunion.jpg';
import eventoPedidaImg from '../assets/images/eventos/pedida_de_mano.jpg';

const { classicPacks, thematicPacks, rentals } = await getServicesAndRentals();

const eventSchemas = [
  getEventsServiceSchema(),
  getBreadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Decoración de Eventos', path: '/eventos' },
  ]),
];

// Separación visual para el mosaico panorámico de Línea Temática (Fila 2: 2 tarjetas; Fila 3: panorámica)
const thematicRowPacks = thematicPacks.filter((p) => p.variant !== 'panoramic');
const thematicPanoramicPacks = thematicPacks.filter((p) => p.variant === 'panoramic');

const serviceTrustItems = [
  { icon: 'verified', title: '100% Flor Fresca', subtitle: 'Selección diaria prémium' },
  { icon: 'architecture', title: 'Diseño a Medida', subtitle: 'Moodboard botánico exclusivo' },
  { icon: 'local_shipping', title: 'Montaje In-Situ', subtitle: 'Cobertura en todo Arequipa' },
  { icon: 'forum', title: 'Asesoría Directa', subtitle: 'Atención 1 a 1 vía WhatsApp' },
] as const;

const processSteps = [
  {
    step: '01',
    title: 'Consulta & Moodboard',
    description:
      'Escuchamos tus ideas, locación, paleta de color deseada y presupuesto para construir un tablero conceptual visual único.',
    footerIcon: 'lightbulb',
    footerLabel: 'Ideación a medida',
  },
  {
    step: '02',
    title: 'Propuesta Floral',
    description:
      'Te entregamos un presupuesto detallado, especificación de flores por variedad y muestra de mobiliario o estructuras accesorias.',
    footerIcon: 'check',
    footerLabel: 'Cotización clara',
  },
  {
    step: '03',
    title: 'Flores Frescas',
    description:
      'Selección rigurosa de flores y follajes recién cortados, cuidando la hidratación y punto óptimo de apertura para el día D.',
    footerIcon: 'eco',
    footerLabel: 'Frescura garantizada',
  },
  {
    step: '04',
    title: 'Montaje In-Situ',
    description:
      'Nuestro equipo se traslada con horas de anticipación a tu local en Arequipa para supervisar cada arreglo y escenografía.',
    footerIcon: 'location_on',
    footerLabel: 'Puntualidad total',
  },
] as const;

const occasionServices = [
  {
    category: 'cumpleanos',
    badge: 'Celebración',
    icon: 'celebration',
    title: 'Cumpleaños',
    description:
      'Ambientación personalizada con arcos de globos, paneles decorativos y detalles adaptados a cualquier edad y temática.',
    bullets: [
      'Decoración con globos y paneles temáticos',
      'Mobiliario y mesa principal equipada',
      'Detalles personalizados según tu estilo',
    ],
    ctaLabel: 'Cotizar Cumpleaños',
    waText: 'Hola ISOTELI, quisiera cotizar la decoración para Cumpleaños',
    image: eventoCumpleanosImg,
    alt: 'Decoración floral y arcos orgánicos de globos para cumpleaños en Arequipa',
  },
  {
    category: 'bautizos',
    badge: 'Ceremonial',
    icon: 'spa',
    title: 'Bautizos',
    description:
      'Decoración delicada en tonos claros con arcos de globos, arreglos florales y ambientación armoniosa para celebrar en familia.',
    bullets: [
      'Arcos de globos y fondo decorativo',
      'Arreglos florales y mesa de honor',
      'Mobiliario y detalles ceremoniales',
    ],
    ctaLabel: 'Cotizar Bautizo',
    waText: 'Hola ISOTELI, quisiera cotizar la decoración para Bautizo',
    image: eventoBautizoImg,
    alt: 'Ambientación de bautizo con flores blancas y detalles ceremoniales en Arequipa',
  },
  {
    category: 'revelacion',
    badge: 'Maternidad & Familia',
    icon: 'child_care',
    title: 'Revelación de Género',
    description:
      'Montajes especiales con globos, estructuras temáticas y detalles en tonos suaves para hacer inolvidable el gran anuncio.',
    bullets: [
      'Decoración con globos y elementos sorpresa',
      'Estructuras, mesas y paneles temáticos',
      'Ambientación personalizada para fotos',
    ],
    ctaLabel: 'Cotizar Revelación de Género',
    waText: 'Hola ISOTELI, deseo cotizar Revelación de Género',
    image: eventoGeneroImg,
    alt: 'Escenografía en tonos pastel y cubos decorativos para revelación de género',
  },
  {
    category: 'comunion',
    badge: 'Primera Comunión',
    icon: 'verified',
    title: 'Primera Comunión',
    description:
      'Escenografía cálida y elegante que combina arcos de globos, flores naturales y mobiliario para una reunión familiar inolvidable.',
    bullets: [
      'Decoración con globos y fondo principal',
      'Centros de mesa y detalles florales',
      'Espacio acondicionado para recepción y fotos',
    ],
    ctaLabel: 'Cotizar Primera Comunión',
    waText: 'Hola ISOTELI, quisiera cotizar Primera Comunión',
    image: eventoComunionImg,
    alt: 'Decoración campestre elegante con flores frescas para Primera Comunión',
  },
  {
    category: 'pedidas',
    badge: 'Romance & Pedidas',
    icon: 'diamond',
    title: 'Pedidas de Mano',
    description:
      'Ambientación romántica con globos, flores frescas, iluminación cálida y montaje sorpresa diseñado para un momento único.',
    bullets: [
      'Decoración romántica con globos y rosas',
      'Iluminación cálida y letreros decorativos',
      'Montaje completo y asesoría personalizada',
    ],
    ctaLabel: 'Planear Pedida de Mano',
    waText: 'Hola ISOTELI, deseo planear una Pedida de Mano',
    image: eventoPedidaImg,
    alt: 'Escenografía romántica con pétalos y velas para pedida de mano en Arequipa',
  },
] as const;
---

<Layout
  title="Decoración de Eventos y Globos en Arequipa | ISOTELI"
  description="Decoración con globos y flores en Arequipa para cumpleaños, bautizos, revelación de género, primera comunión y pedidas de mano. Montaje a domicilio."
  schema={eventSchemas}
>
  <div class="flex flex-col w-full">
    <!-- ================= FRANJA SUPERIOR DE GARANTÍAS DE EVENTOS ================= -->
    <!-- ================= SECCIÓN HERO - PORTAFOLIO DE SERVICIOS POR OCASIÓN (BANNERS VERTICALES) ================= -->
    <section
      class="relative w-full bg-surface-container-low overflow-clip"
      id="catalogo-servicios"
      data-no-aos="true"
    >
      <!-- Elementos fijos (sticky) sobre todos los ítems: título superior y barra de navegación lateral -->
      <div class="sticky top-[164px] sm:top-[150px] md:top-[152px] z-30 h-0 overflow-visible pointer-events-none">
        <div
          id="events-sticky-title"
          class="w-full pt-14 sm:pt-10 md:pt-12 px-5 sm:px-10 flex flex-col items-center text-center"
          data-aos="fade-down"
          data-aos-duration="850"
          data-aos-once="false"
        >
          <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-white tracking-tight leading-tight drop-shadow-lg slide-fade-down">
            Decoración de Eventos y Ambientación en Arequipa
          </h1>
          <p class="font-sans text-xs sm:text-base md:text-lg text-[#ffdad3]/95 mt-1.5 sm:mt-2 max-w-2xl drop-shadow-sm slide-fade-up anim-delay-1">
            Estructuras de diseño escalables y personalizadas para cada tipo de celebración.
          </p>
        </div>

        <!-- Barra de navegación vertical fija sobre los ítems en el extremo derecho -->
        <div
          class="service-vertical-dots pointer-events-auto absolute right-3 sm:right-5 md:right-6 top-[calc((100dvh-164px)/2)] sm:top-[calc((100dvh-150px)/2)] md:top-[calc((100dvh-152px)/2)] -translate-y-1/2 z-30 flex flex-col items-center gap-3"
          aria-label="Navegación vertical de eventos"
        >
          {occasionServices.map((dotSrv, dotIdx) => (
            <a
              href={`#evento-banner-${dotSrv.category}`}
              data-dot-index={String(dotIdx)}
              title={dotSrv.title}
              aria-label={`Ir a ${dotSrv.title}`}
              aria-current={dotIdx === 0 ? 'true' : undefined}
              class:list={[
                'service-dot-link rounded-full transition-all duration-300 border border-white/40',
                dotIdx === 0
                  ? 'w-3 h-8 bg-white shadow-[0_0_12px_rgba(255,255,255,0.6)]'
                  : 'w-2.5 h-2.5 bg-white/35 hover:bg-white/75',
              ]}
            />
          ))}
        </div>
      </div>

      <div class="w-full flex flex-col" id="services-grid">
        {
          occasionServices.map((srv, idx) => (
            <article
              id={`evento-banner-${srv.category}`}
              class="service-card group relative w-full min-h-[calc(100dvh-164px)] sm:min-h-[calc(100dvh-150px)] md:min-h-[calc(100dvh-152px)] scroll-mt-[164px] sm:scroll-mt-[150px] md:scroll-mt-[152px] flex flex-col justify-center overflow-hidden bg-[#1b1c16] border-b border-white/10"
              data-category={srv.category}
            >
              <!-- Imagen de fondo en tamaño completo de pantalla -->
              <Image
                class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover:scale-105 z-0"
                alt={srv.alt}
                loading={idx === 0 ? 'eager' : 'lazy'}
                src={srv.image}
              />

              <!-- Degradado vertical de arriba a abajo -->
              <div
                class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/45 to-black/85 z-10 pointer-events-none"
                aria-hidden="true"
              ></div>
              <!-- Refuerzo sutil lateral izquierdo para lectura nítida -->
              <div
                class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/25 to-transparent z-10 pointer-events-none"
                aria-hidden="true"
              ></div>

              <!-- Contenido centrado en móvil y alineado al extremo izquierdo en escritorio -->
              <div class="relative z-20 w-full px-10 sm:pl-8 md:pl-10 lg:pl-12 sm:pr-16 md:pr-20 pt-44 sm:pt-40 md:pt-44 pb-8 sm:pb-12 my-auto">
                <div
                  class="max-w-xl lg:max-w-2xl mx-auto sm:mx-0 flex flex-col items-center sm:items-start text-center sm:text-left gap-2.5 sm:gap-4 md:gap-5"
                  data-aos="fade-right"
                  data-aos-duration="750"
                  data-aos-once="false"
                >
                  <div
                    class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-white/15 backdrop-blur-md text-[#ffdad3] border border-white/25 text-[11px] sm:text-sm font-semibold tracking-wider uppercase shadow-sm"
                    data-aos="fade-up"
                    data-aos-delay="50"
                    data-aos-once="false"
                  >
                    <span class="material-symbols-outlined text-[15px] sm:text-[16px] text-[#f48b77]" aria-hidden="true">{srv.icon}</span>
                    <span>{srv.badge}</span>
                  </div>

                  <h2
                    class="font-serif text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight drop-shadow-md"
                    data-aos="fade-up"
                    data-aos-delay="120"
                    data-aos-once="false"
                  >
                    {srv.title}
                  </h2>

                  <p
                    class="font-sans text-xs sm:text-base md:text-lg text-white/90 leading-relaxed max-w-xl drop-shadow-sm"
                    data-aos="fade-up"
                    data-aos-delay="180"
                    data-aos-once="false"
                  >
                    {srv.description}
                  </p>

                  <ul
                    class="flex flex-col items-center sm:items-start gap-1.5 sm:gap-2.5 font-sans text-xs sm:text-base text-[#ffdad3] pt-1 sm:pt-2"
                    data-aos="fade-up"
                    data-aos-delay="240"
                    data-aos-once="false"
                  >
                    {srv.bullets.map((bullet) => (
                      <li class="flex items-center justify-center sm:justify-start gap-2 sm:gap-2.5">
                        <span class="material-symbols-outlined text-[#f48b77] text-[16px] sm:text-[18px] shrink-0" aria-hidden="true">
                          check_circle
                        </span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>

                  <div
                    class="pt-2 sm:pt-3 flex flex-wrap items-center justify-center sm:justify-start gap-3 sm:gap-4"
                    data-aos="fade-up"
                    data-aos-delay="300"
                    data-aos-once="false"
                  >
                    <a
                      class="inline-flex items-center justify-center gap-2 sm:gap-3 bg-[#500e05] hover:bg-[#6e2417] text-white border border-[#ffb4a6]/40 px-5 sm:px-8 py-2.5 sm:py-3.5 rounded-full font-sans text-xs sm:text-base font-semibold tracking-wide transition-all shadow-xl hover:shadow-2xl hover:scale-[1.03] active:scale-[0.98]"
                      href={buildWhatsAppUrl(srv.waText)}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <span>{srv.ctaLabel}</span>
                      <span class="material-symbols-outlined text-[16px] sm:text-[18px]" aria-hidden="true">arrow_forward</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>    

    <!-- ================= METODOLOGÍA ISOTELI EN 4 PASOS ================= 
    <section class="w-full bg-surface py-space-xl px-margin-mobile md:px-margin border-b border-outline-variant/30" data-aos="fade-up">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16" data-aos="fade-up">
          <span class="font-label-md text-label-md uppercase tracking-widest text-primary font-bold">
            Metodología ISOTELI
          </span>
          <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold mt-1">
            Cómo Creamos la Magia de tu Evento
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-3">
            Un proceso minucioso y transparente desde la primera idea hasta el último pétalo colocado en tu recepción.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
          {
            processSteps.map((st, idx) => (
              <div
                class="bg-surface-container-lowest p-6 rounded-lg flex flex-col justify-between shadow-sm relative group hover:-translate-y-1 transition-transform border border-outline-variant/30"
                data-aos="fade-up"
                data-aos-delay={idx * 80}
              >
                <div>
                  <div class="flex items-center justify-between mb-6">
                    <span class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container font-bold flex items-center justify-center font-headline-sm text-headline-sm">
                      {st.step}
                    </span>
                  </div>
                  <h3 class="font-headline-sm text-headline-sm text-primary font-semibold mb-2">
                    {st.title}
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    {st.description}
                  </p>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center text-primary font-label-md text-label-md">
                  <span class="material-symbols-outlined text-[15px] mr-1" aria-hidden="true">
                    {st.footerIcon}
                  </span>
                  <span>{st.footerLabel}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section> -->

    <!-- ================= GALERÍA DE MONTAJES REALIZADOS EN AREQUIPA ================= -->
    <section id="galeria-montajes" class="w-full px-margin-mobile md:px-margin py-space-xl scroll-mt-[164px] sm:scroll-mt-[150px] md:scroll-mt-[152px]" data-aos="fade-up">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8" data-aos="fade-up">
          <div>
            <span class="font-label-md text-label-md uppercase tracking-widest text-primary font-bold">
              Galería de Eventos
            </span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">
              Montajes Realizados en Arequipa
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-primary font-label-md text-label-md border border-outline-variant/30">
              <span class="material-symbols-outlined text-[14px]" aria-hidden="true">pin_drop</span>
              <span>Yanahuara • Cayma • Sabandía • J.L.B. y Rivero</span>
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[220px]">
          <div class="md:col-span-2 md:row-span-2 relative rounded-xl overflow-hidden group shadow-sm" data-aos="fade-up">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              alt="Mesa imperial de matrimonio al aire libre en Sabandía con centros de mesa florales altos de rosas y hortensias"
              loading="lazy"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDiHBhnWGSmiUDH7pUeMHC1u4ADHRL02BQg4Tr8NtAzMFl-1NfFPgD9cp-jDSDc1Dfon0bRdea2rVkJ8Dt7h18xJqe0qYPsMRc_rHu6VfnUjdLPqKF-qzOwu4qCdhnQZhExlrxxZEIeZTFYk_GKayX0fG3hUWO6XdNczWxVNpFm4yiVMwuIWipXnoHC50j0RRxQQF0L_77wBOXXM99JOw7r7AGMXwb5UHAjZ8nT3Xpe5ZtlojgNvIDkJw"
              onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-transparent flex flex-col justify-end p-6">
              <span class="text-on-primary/80 font-label-md text-label-md uppercase tracking-wider">
                Recepción de Matrimonio
              </span>
              <p class="font-headline-sm text-headline-sm text-on-primary font-semibold">
                Casona &amp; Jardines en Sabandía
              </p>
            </div>
          </div>

          <div class="relative rounded-xl overflow-hidden group shadow-sm">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              alt="Ramo de novia couture con rosas durazno, ranúnculos blancos, eucalipto y cinta de seda"
              loading="lazy"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAbU1HODzU-vpMpr2nEdFjy7rWOheKd4oImzdmFfLvsh-4WsUt9iLMP5R7LKz3hwtEwbRzsTzw4QhPrnhxXal8Dy6FIZMtdPCzq7sSLWKgLaAqN5q5uWZWfxE49vCa-3x8WtBqItviQSgwP20u90hL61zyIVZIvcgNdGfH3W0qRFLlfsRtcrEDNI37Yzdtc7JaptWByBnqB4Qx1HBq7vupv9zcnx7OnIheUd-uqaEz9EuLvKsLR0489CQ"
              onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/75 via-transparent to-transparent flex flex-col justify-end p-4">
              <span class="text-on-primary font-label-md text-label-md">Ramo de Novia Couture</span>
            </div>
          </div>

          <div class="relative rounded-xl overflow-hidden group shadow-sm">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              alt="Arco circular botánico iluminado con lluvia de luces cálidas y sillar arequipeño de fondo"
              loading="lazy"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAEDJ6yCpgvDIVuRqy9eyZ_fGTybo7_J4FvF9DwqMubovq7CWbInObLpc0yBgWWO40ISqPGMAefxcYdEcw_pmYE8itzUhaS62-cUA1VrNJoe0jeOUOJ8_0ZGlEkkwtz0DOidyq-Gvm5-Pp6SkSk08yH7PAa_GdAym2yh_fgxFsya18dwkDjSmFDnAd6r9KqGT3gKHIlcsNOrFfwZLoQDJbS4MgJWKDiAbXCi9MwZHjBAV8WU_P6gJ4scw"
              onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/75 via-transparent to-transparent flex flex-col justify-end p-4">
              <span class="text-on-primary font-label-md text-label-md">Arco Botánico Iluminado</span>
            </div>
          </div>

          <div class="md:col-span-2 relative rounded-xl overflow-hidden group shadow-sm">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              alt="Escenografía botánica minimalista con pedestales florales asimétricos para evento corporativo en Arequipa"
              loading="lazy"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCE5Nwe-8lJcacySJscr4rhJHqCow2KWMf5PxkyC8Ol3Xcm2AYIXPwUmPUh1HUeRd5E3JPx1SXOv8M2IB5ax-ALQRRP7BkDvhriTJE2QQyjNDa7i6D9Hcxo_ewo5454_DZ2mjDq6rrCFqLgzYzogQemI7EhurUChiViuU8EWikZYkSrYJB-8863ikx0OW3CSQz1Ereo5idfAwzCQVWgJdw62LkLiG4vGbIBE7ZX8Txml8ZsNdrSr7LtCg"
              onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/75 via-transparent to-transparent flex flex-col justify-end p-6">
              <span class="text-on-primary/80 font-label-md text-label-md uppercase tracking-wider">
                Lanzamiento Corporativo
              </span>
              <p class="font-headline-sm text-headline-sm text-on-primary font-semibold">
                Escenografía Botánica Minimalista
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>



    <!-- ================= LLAMADA A LA ACCIÓN FINAL DE EVENTOS ================= -->
    <section class="w-full px-margin-mobile md:px-margin py-space-xl" data-aos="zoom-in">
      <div class="max-w-7xl mx-auto rounded-xl bg-primary text-on-primary p-8 md:p-14 relative overflow-hidden shadow-lg text-center md:text-left flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-container text-surface-container-lowest font-label-md text-label-md uppercase tracking-widest mb-4">
            <span class="material-symbols-outlined text-[14px]" aria-hidden="true">local_florist</span>
            <span>Florería Boutique • Arequipa</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg font-bold text-on-primary leading-tight">
            Diseñemos juntos la ambientación de tu próximo evento.
          </h2>
          <p class="font-body-lg text-body-lg text-primary-fixed mt-3 max-w-xl">
            Agenda tu videollamada o coordina directamente al WhatsApp {ISOTELI_CONTACT.phoneShort}. Atención presencial en {ISOTELI_CONTACT.officeShortAddress} previa cita.
          </p>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row items-center gap-4 shrink-0">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-surface-container-lowest hover:bg-surface-container-low text-primary px-8 py-4 rounded-full font-label-lg text-label-lg tracking-wider transition-all duration-300 shadow-md hover:scale-105 font-semibold"
            href={buildWhatsAppUrl('Hola ISOTELI, deseo coordinar la ambientación de un evento')}
            rel="noopener noreferrer"
            target="_blank"
          >
            <WhatsAppIcon class="w-5 h-5 text-[#25D366]" />
            <span>WhatsApp {ISOTELI_CONTACT.phoneShort}</span>
          </a>

          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary hover:bg-secondary/90 px-6 py-4 rounded-full font-label-lg text-label-lg tracking-wider transition-colors border border-secondary"
            href={`tel:+${ISOTELI_CONTACT.phoneRaw}`}
          >
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">call</span>
            <span>Llamar Ahora</span>
          </a>
        </div>

        <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-primary-container/40 pointer-events-none blur-2xl"></div>
        <div class="absolute -left-20 -top-20 w-80 h-80 rounded-full bg-surface-dim/20 pointer-events-none blur-3xl"></div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import AOS from 'aos';
  import { syncServicesPage } from '../lib/live-cms-sync';

  void syncServicesPage();

  // Filtro interactivo para Líneas de Paquetes de Decoración (Clásica vs Temática)
  const lineBtns = document.querySelectorAll<HTMLButtonElement>('[data-pack-line-btn]');
  const packGroups = document.querySelectorAll<HTMLElement>('[data-pack-group]');

  lineBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.packLineBtn || 'all';
      lineBtns.forEach((b) => {
        b.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
        b.classList.add('bg-surface-container', 'text-on-surface-variant');
      });
      btn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
      btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

      packGroups.forEach((group) => {
        const groupLine = group.dataset.packGroup;
        group.classList.toggle('hidden', selected !== 'all' && groupLine !== selected);
      });
    });
  });

  // Control de scroll por pantalla completa para los banners verticales de eventos + AOS
  const catalogSectionEl = document.getElementById('catalogo-servicios');
  const banners = Array.from(document.querySelectorAll<HTMLElement>('.service-card'));
  const dotLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.service-dot-link'));
  const nextSectionEl = (() => {
    let el = catalogSectionEl?.nextElementSibling as HTMLElement | null;
    while (el && el.tagName !== 'SECTION') {
      el = el.nextElementSibling as HTMLElement | null;
    }
    return el;
  })();
  const headerEl = document.querySelector<HTMLElement>('header');
  let isSnapScrolling = false;
  let snapUnlockTimer: number | undefined;

  const getHeaderHeight = () => (headerEl ? headerEl.getBoundingClientRect().height : 152);

  const updateActiveDot = (activeIndex: number) => {
    if (activeIndex < 0) return;
    dotLinks.forEach((dot, i) => {
      const isActive = i === activeIndex;
      dot.classList.toggle('w-3', isActive);
      dot.classList.toggle('h-8', isActive);
      dot.classList.toggle('bg-white', isActive);
      dot.classList.toggle('shadow-[0_0_12px_rgba(255,255,255,0.6)]', isActive);
      dot.classList.toggle('w-2.5', !isActive);
      dot.classList.toggle('h-2.5', !isActive);
      dot.classList.toggle('bg-white/35', !isActive);
      dot.classList.toggle('hover:bg-white/75', !isActive);
      if (isActive) {
        dot.setAttribute('aria-current', 'true');
      } else {
        dot.removeAttribute('aria-current');
      }
    });
  };

  const scrollToBanner = (targetEl: HTMLElement) => {
    if (isSnapScrolling) return;
    isSnapScrolling = true;
    window.clearTimeout(snapUnlockTimer);

    const targetBannerIdx = banners.indexOf(targetEl);
    if (targetBannerIdx !== -1) {
      updateActiveDot(targetBannerIdx);
    }

    const hHeight = getHeaderHeight();
    const targetTop = Math.max(0, targetEl.getBoundingClientRect().top + window.scrollY - hHeight);

    const aosEls = [
      ...(targetEl.hasAttribute('data-aos') ? [targetEl] : []),
      ...Array.from(targetEl.querySelectorAll<HTMLElement>('[data-aos]')),
    ];
    aosEls.forEach((el) => el.classList.remove('aos-animate'));

    window.scrollTo({
      top: targetTop,
      behavior: 'smooth',
    });

    window.setTimeout(() => {
      aosEls.forEach((el) => el.classList.add('aos-animate'));
      AOS.refresh();
    }, 320);

    snapUnlockTimer = window.setTimeout(() => {
      isSnapScrolling = false;
    }, 780);
  };

  const getActiveBannerIndex = (): number => {
    const hHeight = getHeaderHeight();
    const viewTop = hHeight;
    const viewBottom = window.innerHeight;
    let bestIdx = -1;
    let bestVisible = 0;

    banners.forEach((banner, index) => {
      const rect = banner.getBoundingClientRect();
      const visibleHeight = Math.max(0, Math.min(rect.bottom, viewBottom) - Math.max(rect.top, viewTop));
      if (visibleHeight > bestVisible) {
        bestVisible = visibleHeight;
        bestIdx = index;
      }
    });

    return bestVisible > 60 ? bestIdx : -1;
  };

  let scrollSyncRaf = 0;
  window.addEventListener(
    'scroll',
    () => {
      if (scrollSyncRaf) return;
      scrollSyncRaf = window.requestAnimationFrame(() => {
        scrollSyncRaf = 0;
        updateActiveDot(getActiveBannerIndex());
      });
    },
    { passive: true }
  );

  // Clic en controlador lateral derecho
  document.querySelectorAll<HTMLAnchorElement>('.service-vertical-dots a').forEach((link) => {
    link.addEventListener('click', (e) => {
      const targetId = link.getAttribute('href')?.replace('#', '');
      if (!targetId) return;
      const targetCard = document.getElementById(targetId);
      if (!targetCard) return;

      e.preventDefault();
      isSnapScrolling = false;
      scrollToBanner(targetCard);
    });
  });

  // Scroll con rueda del ratón / trackpad: posiciona cada ítem y baja al siguiente segmento al terminar
  window.addEventListener(
    'wheel',
    (e) => {
      if (banners.length === 0) return;

      const hHeight = getHeaderHeight();
      const firstTop = banners[0]!.getBoundingClientRect().top;
      const lastBottom = banners[banners.length - 1]!.getBoundingClientRect().bottom;
      const nextRect = nextSectionEl?.getBoundingClientRect();

      // Si está justo al inicio del siguiente segmento y sube, regresa al último ítem de eventos
      if (
        e.deltaY < -10 &&
        nextRect &&
        nextRect.top >= hHeight - 40 &&
        nextRect.top <= hHeight + 120
      ) {
        if (isSnapScrolling) {
          e.preventDefault();
          return;
        }
        e.preventDefault();
        scrollToBanner(banners[banners.length - 1]!);
        return;
      }

      // Si estamos fuera del bloque de banners (más abajo en paquetes/footer), no interceptar
      if (firstTop > window.innerHeight * 0.5 || lastBottom <= hHeight + 40) {
        return;
      }

      const activeIdx = getActiveBannerIndex();
      if (activeIdx === -1) return;

      if (Math.abs(e.deltaY) < 8) return;

      if (isSnapScrolling) {
        e.preventDefault();
        return;
      }

      const activeRect = banners[activeIdx]!.getBoundingClientRect();

      if (e.deltaY > 0) {
        // Bajando: ir al siguiente banner o al siguiente segmento de la página al terminar
        if (activeIdx < banners.length - 1) {
          e.preventDefault();
          scrollToBanner(banners[activeIdx + 1]!);
        } else if (nextSectionEl) {
          e.preventDefault();
          scrollToBanner(nextSectionEl);
        }
      } else {
        // Subiendo: alinear al banner actual si estaba desplazado hacia abajo, o subir al anterior
        if (activeRect.top < hHeight - 80) {
          e.preventDefault();
          scrollToBanner(banners[activeIdx]!);
        } else if (activeIdx > 0) {
          e.preventDefault();
          scrollToBanner(banners[activeIdx - 1]!);
        }
      }
    },
    { passive: false }
  );

  // Soporte táctil para deslizar en pantallas móviles dentro de los banners
  const servicesGrid = document.getElementById('services-grid');
  let touchStartY = 0;

  servicesGrid?.addEventListener(
    'touchstart',
    (e) => {
      touchStartY = e.touches[0]?.clientY ?? 0;
    },
    { passive: true }
  );

  servicesGrid?.addEventListener(
    'touchend',
    (e) => {
      if (isSnapScrolling || banners.length === 0) return;
      const touchEndY = e.changedTouches[0]?.clientY ?? touchStartY;
      const deltaY = touchStartY - touchEndY;
      if (Math.abs(deltaY) < 55) return;

      const activeIdx = getActiveBannerIndex();
      if (activeIdx === -1) return;

      if (deltaY > 0) {
        if (activeIdx < banners.length - 1) {
          scrollToBanner(banners[activeIdx + 1]!);
        } else if (nextSectionEl) {
          scrollToBanner(nextSectionEl);
        }
      } else if (deltaY < 0 && activeIdx > 0) {
        scrollToBanner(banners[activeIdx - 1]!);
      }
    },
    { passive: true }
  );
</script>

<style>
  @keyframes eventosFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes eventosFadeDown {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .slide-fade-up {
    opacity: 0;
    animation: eventosFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: opacity, transform;
  }

  .slide-fade-down {
    opacity: 0;
    animation: eventosFadeDown 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: opacity, transform;
  }

  .anim-delay-1 {
    animation-delay: 160ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-fade-up,
    .slide-fade-down {
      transform: none !important;
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>

