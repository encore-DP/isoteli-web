---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'ISOTELI Flores y Detalles: Atelier floral 100% virtual en Arequipa. Ramos de rosas, cajas florales, chocolates La Ibérica, decoración de eventos y alquiler de mobiliario.',
  ogImage = '/images/placeholder-floral.svg',
} = Astro.props;

const fullTitle = title.includes('ISOTELI')
  ? title
  : `${title} | ISOTELI Florería & Decoración Arequipa`;
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Metadatos SEO Dinámicos -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Tipografías Editoriales e Iconografía Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background font-body-md text-on-surface antialiased min-h-screen flex flex-col selection:bg-primary-fixed selection:text-on-primary-fixed">
    <!-- ================= CABECERA GLOBAL FIJA (TOPBAR + NAVBAR) ================= -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(194,101,42,0.08)]">
      <TopBar />
      <Navbar />
    </header>

    <!-- ================= CONTENIDO PRINCIPAL DE CADA VISTA ================= -->
    <main class="w-full pt-28 bg-background flex-1">
      <slot />
    </main>

    <!-- ================= PIE DE PÁGINA GLOBAL ================= -->
    <Footer />

    <!-- ================= ACCESO RÁPIDO WHATSAPP FLOTANTE ================= -->
    <WhatsAppFloat />
  </body>
</html>
