---
import '../styles/global.css';
import 'aos/dist/aos.css';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Image } from 'astro:assets';
import logoFavicon from '../assets/logo/favicon.svg';
import { getFloristSchema, SITE_URL } from '../lib/seo-schema';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description = 'ISOTELI Flores y Detalles: Florería en Arequipa con delivery el mismo día. Ramos de rosas, cajas florales personalizadas y decoración de eventos.',
  ogImage = '/images/placeholder-floral.svg',
  canonicalPath,
  schema,
  noindex = false,
} = Astro.props;

const fullTitle = title.includes('ISOTELI')
  ? title
  : `${title} | ISOTELI Florería Arequipa`;

const rawPath = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/$/, '');
const cleanPath = canonicalPath ?? (rawPath || '/');
const canonicalUrl = `${SITE_URL}${cleanPath === '/' ? '' : cleanPath}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;

// Construcción del grafo de Schema.org unificado
const extraSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [getFloristSchema(), ...extraSchemas],
};
const jsonLdString = JSON.stringify(jsonLdGraph);
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ERGL8Q8QTD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-ERGL8Q8QTD');
    </script>

    <!-- Favicon Oficial ISOTELI (src/assets/logo/favicon.svg) -->
    <link rel="icon" type="image/svg+xml" href={logoFavicon.src} />

    <!-- Metadatos SEO Primarios -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Local SEO Geo-Tags para Arequipa, Perú -->
    <meta name="geo.region" content="PE-ARE" />
    <meta name="geo.placename" content="Arequipa" />
    <meta name="geo.position" content="-16.413809;-71.520988" />
    <meta name="ICBM" content="-16.413809, -71.520988" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:site_name" content="ISOTELI Florería Arequipa" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Datos Estructurados JSON-LD (@graph Schema.org) -->
    <script type="application/ld+json" set:html={jsonLdString} />

    <!-- Tipografías Editoriales: Playfair Display (Títulos) y Poppins (Textos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background font-body-md text-on-surface antialiased min-h-screen flex flex-col selection:bg-primary-fixed selection:text-on-primary-fixed">
    <!-- ================= CABECERA GLOBAL FIJA (TOPBAR + NAVBAR) ================= -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(194,101,42,0.08)]">
      <TopBar />
      <Navbar />
    </header>

    <!-- ================= CONTENIDO PRINCIPAL DE CADA VISTA ================= -->
    <main class="w-full pt-[138px] sm:pt-[118px] md:pt-[120px] bg-background flex-1">
      <slot />
    </main>

    <!-- ================= PIE DE PÁGINA GLOBAL ================= -->
    <Footer />

    <!-- ================= ACCESO RÁPIDO WHATSAPP FLOTANTE ================= -->
    <WhatsAppFloat />

    <!-- ================= INICIALIZACIÓN DE ANIMACIONES AOS ================= -->
    <script>
      import AOS from 'aos';

      const initAOS = () => {
        // Garantizar que todas las secciones y segmentos principales tengan animación de entrada
        document.querySelectorAll('main section, footer').forEach((sec) => {
          if (!sec.hasAttribute('data-aos')) {
            sec.setAttribute('data-aos', 'fade-up');
          }
        });

        AOS.init({
          duration: 750,
          easing: 'ease-out-cubic',
          once: true,
          offset: 50,
          delay: 30,
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAOS);
      } else {
        initAOS();
      }

      window.addEventListener('load', () => {
        AOS.refresh();
      });
    </script>
  </body>
</html>
