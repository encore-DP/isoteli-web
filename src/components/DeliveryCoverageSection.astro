---
import { AREQUIPA_DISTRICTS, ISOTELI_CONTACT } from '../data/business';

export interface Props {
  id?: string;
}

const { id = 'cobertura-distrital' } = Astro.props;
---

<!-- ================= COBERTURA DE DELIVERY Y LÍMITES DISTRITALES AREQUIPA ================= -->
<section class="w-full px-margin-mobile md:px-margin py-space-lg" id={id}>
  <div class="rounded-xl bg-surface-container p-8 md:p-12 lg:p-14 border border-outline-variant/30">
    <div class="flex flex-col gap-6">
      <!-- Cabecera de Tarifas de Envío -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-outline-variant/30">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary-fixed text-primary font-label-md text-label-md font-semibold tracking-wider mb-2">
            <span class="material-symbols-outlined text-[15px]" aria-hidden="true">local_shipping</span>
            <span>POLÍTICA DE DELIVERY AREQUIPA</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg text-primary">
            Cobertura de Delivery y Límites Distritales
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Pedidos inmediatos: <strong class="text-on-surface">mínimo 1 hora, máximo 3 horas</strong> según disponibilidad de movilidad (coordinación previa).
          </p>
        </div>

        <div class="bg-surface rounded-xl p-4 shadow-sm border border-primary/30 flex flex-col gap-1.5 shrink-0 max-w-md">
          <div class="flex items-center gap-2 text-primary font-bold font-headline-sm text-headline-sm">
            <span class="material-symbols-outlined text-[22px]" aria-hidden="true">redeem</span>
            <span>Delivery GRATIS en compras &gt; S/ 99.90</span>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface-variant">
            Para compras menores a S/ 99.90: Tarifa fija de <strong class="text-on-surface">S/ 10</strong> dentro de la cobertura principal. Distritos restantes: <strong class="text-on-surface">S/ 15</strong>.
          </p>
        </div>
      </div>

      <!-- Grilla de 9 Distritos con Límites Exactos -->
      <div>
        <h3 class="font-headline-sm text-headline-sm text-primary mb-3 flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px] text-primary" aria-hidden="true">pin_drop</span>
          <span>Distritos con Cobertura (S/ 10 o Gratis &gt; S/ 99.90)</span>
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            AREQUIPA_DISTRICTS.map((district) => (
              <div class="p-3.5 rounded-lg bg-surface flex flex-col gap-1 border border-outline-variant/30">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-label-lg text-label-lg font-bold text-primary">{district.name}</span>
                  <span
                    class:list={[
                      'px-2 py-0.5 rounded-full text-[11px] font-semibold shrink-0',
                      district.fullCoverage
                        ? 'bg-secondary-container text-secondary'
                        : 'bg-surface-container-high text-on-surface-variant border border-outline-variant/40',
                    ]}
                  >
                    {district.badge}
                  </span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  {district.fullCoverage ? (
                    district.boundaryDetail
                  ) : (
                    <>
                      Límite: <strong class="text-on-surface">{district.boundaryDetail}</strong>
                    </>
                  )}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Zonas Periféricas y Métodos de Pago -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-lg bg-surface text-on-surface flex items-start gap-3 border border-outline-variant/30">
          <span class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5" aria-hidden="true">navigation</span>
          <div>
            <p class="font-label-lg text-label-lg font-bold text-primary">
              Distritos Restantes y Zonas Periféricas
            </p>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
              Tarifa de envío: <strong class="text-on-surface">S/ 15</strong> ({ISOTELI_CONTACT.deliveryPolicy.peripheralDistricts}). Se coordina horario exacto de entrega con el cliente.
            </p>
          </div>
        </div>

        <div class="p-4 rounded-lg bg-surface text-on-surface flex items-start gap-3 border border-outline-variant/30">
          <span class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5" aria-hidden="true">payments</span>
          <div>
            <p class="font-label-lg text-label-lg font-bold text-primary">
              Métodos de Pago Disponibles
            </p>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
              Aceptamos <strong class="text-on-surface">Transferencia bancaria</strong>, <strong class="text-on-surface">Yape</strong> y <strong class="text-on-surface">Plin</strong> al número oficial {ISOTELI_CONTACT.phoneDisplay} para mayor comodidad y rapidez.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

