---
import { ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import type { CatalogProduct, ServicePack } from '../lib/wp-graphql';
import WhatsAppIcon from './WhatsAppIcon.astro';

export interface Props {
  products?: readonly CatalogProduct[];
  decorationPacks?: readonly ServicePack[];
}

const { products = [], decorationPacks = [] } = Astro.props;

/* ==========================================================================
   DATOS DINÁMICOS DEL SLIDE 1 (NUESTROS DESTACADOS)
   Extraídos de WooCommerce o con fallback exacto al diseño aprobado
   ========================================================================== */
const defaultFeaturedItems = [
  {
    name: 'Caja Isoteli con Rosas',
    formattedPrice: 'S/ 45.00',
    slug: 'girasoles',
    fallbackThumb: '/images/hero/thumb-caja-rosas.webp',
  },
  {
    name: 'Caja Isoteli con Girasoles',
    formattedPrice: 'S/ 45.00',
    slug: 'caja-isoteli-con-girasoles',
    fallbackThumb: '/images/hero/thumb-caja-girasoles.webp',
  },
  {
    name: 'Box Vibrante',
    formattedPrice: 'S/ 75.00',
    slug: 'box-vibrante',
    fallbackThumb: '/images/hero/thumb-box-vibrante.webp',
  },
] as const;

const slide1Products = defaultFeaturedItems.map((item) => {
  const match = products.find(
    (p) =>
      p.slug === item.slug ||
      p.name.toLowerCase().includes(item.name.toLowerCase().replace('caja isoteli con ', ''))
  );

  const hasRealImage = match?.imageUrl && !match.imageUrl.includes('producto_sin_foto');

  return {
    name: match?.name || item.name,
    formattedPrice: match?.formattedPrice || item.formattedPrice,
    slug: match?.slug || item.slug,
    thumb: hasRealImage ? match!.imageUrl : item.fallbackThumb,
    productUrl: `/producto/${match?.slug || item.slug}`,
    waUrl: buildWhatsAppUrl(
      `Hola ISOTELI, quisiera pedir: ${match?.name || item.name} (${match?.formattedPrice || item.formattedPrice})`
    ),
  };
});

/* ==========================================================================
   DATOS DINÁMICOS DEL SLIDE 2 (DECORACIÓN DE EVENTOS)
   Precios dinámicos de packs WooCommerce con fallback seguro
   ========================================================================== */
const petitPack = decorationPacks.find((p) => /petit/i.test(p.name || p.slug));
const goldPack = decorationPacks.find((p) => /gold/i.test(p.name || p.slug));
const deluxePack = decorationPacks.find((p) => /deluxe/i.test(p.name || p.slug));

const petitPrice = petitPack?.formattedPrice?.replace('.00', '').replace(/\s+/g, '') || 'S/150';
const goldPrice = goldPack?.formattedPrice?.replace('.00', '').replace(/\s+/g, '') || 'S/250';
const deluxePrice = deluxePack?.formattedPrice?.replace('.00', '').replace(/\s+/g, '') || 'S/490';
---

<!-- ================= CARRUSEL HERO DINÁMICO ISOTELI (3 SLIDES) ================= -->
<section
  class="relative w-full px-margin-mobile mt-4 sm:mt-6 md:px-margin pb-space-sm sm:pb-space-md overflow-hidden"
  data-aos="fade-up"
  aria-roledescription="carousel"
  aria-label="Promociones y Colecciones Destacadas de ISOTELI"
>
  <div
    id="hero-carousel-container"
    class="relative w-full bg-[#FAF4EE] rounded-2xl lg:rounded-3xl overflow-hidden shadow-[0_8px_30px_rgba(80,14,5,0.08)] border border-[#ECD9CC]/70 group select-none"
  >
    <!-- 1. CAPA DE FONDO CON PATRÓN FLORAL Y LAZOS (LOCAL: src/assets/patron_isoteli.png) -->
    <div
      class="absolute inset-0 pointer-events-none opacity-20 bg-repeat z-0"
      style="background-image: url('/images/patron_isoteli.png'); background-size: 420px auto; filter: blur(0.6px);"
      aria-hidden="true"
    ></div>

    <!-- 2. DEGRADADO SUAVE DE CONTRASTE EDITORIAL -->
    <div
      class="absolute inset-0 pointer-events-none bg-gradient-to-r from-[#FAF4EE]/95 via-[#FAF4EE]/75 to-[#FAF4EE]/35 z-0"
      aria-hidden="true"
    ></div>

    <!-- 3. CONTENEDOR DE SLIDES TRANSICIONABLES -->
    <div class="relative w-full min-h-[460px] sm:min-h-[400px] lg:min-h-[360px] z-10 flex">
      <!-- ===================================================================
           SLIDE 1: SERVICIO DE FLORERÍA ("NUESTROS DESTACADOS")
           =================================================================== -->
      <article
        data-hero-slide="0"
        class="hero-slide w-full flex-none transition-opacity duration-700 ease-in-out opacity-100 z-10 p-6 sm:p-8 lg:p-10 flex flex-col justify-between min-h-[460px] sm:min-h-[400px] lg:min-h-[360px]"
        aria-label="Slide 1 de 3: Nuestros Productos Destacados"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center flex-1 w-full">
          <!-- Columna Izquierda: Insignia + Textos + CTA -->
          <div class="lg:col-span-5 xl:col-span-4 flex flex-col items-start gap-4 sm:gap-5 max-w-md">
            <div class="flex flex-col">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/90 border border-[#ECD9CC] text-[#500e05] text-[11px] sm:text-xs font-semibold uppercase tracking-wider mb-2.5 w-fit shadow-xs">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
                <span>100% Flores Frescas</span>
              </span>
              <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl xl:text-[40px] font-bold tracking-tight text-[#500e05] uppercase leading-tight">
                <span class="sr-only">Florería en Arequipa • Envíos a Domicilio - </span>
                NUESTROS DESTACADOS
              </h1>
              <p class="font-sans text-sm sm:text-base lg:text-lg text-[#55423f] font-normal mt-1">
                Detalles que enamoran
              </p>
            </div>

            <!-- Botón CTA único: Ver catálogo -->
            <div class="pt-1 sm:pt-2">
              <a
                href="/catalogo"
                class="inline-flex items-center justify-center bg-[#500e05] hover:bg-[#6e2417] text-white font-sans text-xs sm:text-sm font-semibold px-6 sm:px-7 py-2.5 sm:py-3 rounded-full transition-all shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-[0.98]"
              >
                <span>Ver catálogo</span>
              </a>
            </div>
          </div>

          <!-- Columna Derecha: Grilla de los 3 Productos Destacados (1x1 con nombre y precio DEBAJO) -->
          <div class="lg:col-span-7 xl:col-span-8 w-full">
            <div class="grid grid-cols-3 gap-2.5 sm:gap-3.5 lg:gap-4.5 w-full">
              {
                slide1Products.map((prod) => (
                  <a
                    href={prod.productUrl}
                    class="bg-white/95 hover:bg-white rounded-2xl p-2 sm:p-3 shadow-xs hover:shadow-md border border-[#ECD9CC] hover:border-primary/40 flex flex-col transition-all group/card focus:outline-none"
                    aria-label={`Ver producto: ${prod.name}`}
                  >
                    <!-- Imagen en proporción 1x1 -->
                    <div class="w-full aspect-square rounded-xl overflow-hidden bg-[#FAF4EE] shrink-0 relative">
                      <img
                        src={prod.thumb}
                        alt={`${prod.name} - ISOTELI Florería Arequipa`}
                        loading="eager"
                        decoding="async"
                        class="w-full h-full object-cover object-center group-hover/card:scale-105 transition-transform duration-300"
                      />
                    </div>

                    <!-- Nombre y Precio DEBAJO de la imagen -->
                    <div class="flex flex-col mt-2 sm:mt-2.5 flex-1 justify-between">
                      <span class="text-xs sm:text-[13px] font-bold text-[#500e05] group-hover/card:text-[#6e2417] transition-colors leading-tight line-clamp-2">
                        {prod.name}
                      </span>
                      <div class="flex items-center justify-between mt-1 sm:mt-1.5 pt-0.5">
                        <span class="text-xs sm:text-[13px] font-bold text-[#6e2417]">
                          {prod.formattedPrice}
                        </span>
                        <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#500e05]/10 group-hover/card:bg-[#500e05] text-[#500e05] group-hover/card:text-white flex items-center justify-center transition-colors shrink-0">
                          <span class="material-symbols-outlined text-[12px] sm:text-[14px]" aria-hidden="true">
                            arrow_forward
                          </span>
                        </span>
                      </div>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Contacto Inferior Discreto con WhatsApp -->
        <div class="pt-3 sm:pt-4 flex items-center justify-center sm:justify-start">
          <a
            href={buildWhatsAppUrl('Hola ISOTELI, deseo consultar por un arreglo floral')}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-[#55423f] hover:text-[#500e05] font-medium transition-colors"
          >
            <WhatsAppIcon class="w-3.5 h-3.5 text-[#25D366]" />
            <span>{ISOTELI_CONTACT.phoneDisplay}</span>
          </a>
        </div>
      </article>

      <!-- ===================================================================
           SLIDE 2: SERVICIO DE DECORACIÓN DE EVENTOS ("DECORACIÓN DE EVENTOS")
           =================================================================== -->
      <article
        data-hero-slide="1"
        class="hero-slide w-full flex-none transition-opacity duration-700 ease-in-out opacity-0 absolute inset-0 pointer-events-none flex flex-col lg:flex-row justify-between items-stretch overflow-hidden min-h-[460px] sm:min-h-[400px] lg:min-h-[360px]"
        aria-label="Slide 2 de 3: Decoración de Eventos en Arequipa"
      >
        <!-- Columna Izquierda con padding -->
        <div class="flex-1 p-6 sm:p-8 lg:p-10 flex flex-col justify-between z-10 max-w-xl">
          <div class="flex flex-col items-start gap-4 sm:gap-5">
            <div class="flex flex-col">
              <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl xl:text-[40px] font-bold tracking-tight text-[#500e05] uppercase leading-tight">
                DECORACIÓN DE EVENTOS
