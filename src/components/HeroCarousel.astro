---
import { ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import type { CatalogProduct, ServicePack } from '../lib/wp-graphql';
import WhatsAppIcon from './WhatsAppIcon.astro';

// Imágenes horizontales para versiones de escritorio (src/assets/images/)
import bannerCatalogoImg from '../assets/images/banner_catalogo.jpg';
import bannerDecoracionImg from '../assets/images/banner_decoracion.jpg';
import bannerFloresEternasImg from '../assets/images/banner_floreseternas.jpg';

// Imágenes verticales para versiones móviles (src/assets/images/)
import verticalBannerCatalogoImg from '../assets/images/vertical_banner_catalogo.jpg';
import verticalBannerDecoracionImg from '../assets/images/vertical_banner_decoracion.jpg';
import verticalBannerFloresEternasImg from '../assets/images/vertical_banner_floreseternas.jpg';

export interface Props {
  products?: readonly CatalogProduct[];
  decorationPacks?: readonly ServicePack[];
}

const { products = [], decorationPacks = [] } = Astro.props;

/* ==========================================================================
   DATOS DINÁMICOS DEL SLIDE 2 (DECORACIÓN DE EVENTOS)
   Precios dinámicos de packs WooCommerce con fallback seguro
   ========================================================================== */
const petitPack = decorationPacks.find((p) => /petit/i.test(p.name || p.slug));
const goldPack = decorationPacks.find((p) => /gold/i.test(p.name || p.slug));
const deluxePack = decorationPacks.find((p) => /deluxe/i.test(p.name || p.slug));

const petitPrice = petitPack?.formattedPrice?.replace('.00', '').replace(/\s+/g, '') || 'S/150';
const goldPrice = goldPack?.formattedPrice?.replace('.00', '').replace(/\s+/g, '') || 'S/250';
const deluxePrice = deluxePack?.formattedPrice?.replace('.00', '').replace(/\s+/g, '') || 'S/490';
---

<!-- ================= CARRUSEL HERO 100% ANCHO Y ALTO DE PANTALLA ================= -->
<section
  class="relative w-full overflow-hidden"
  data-aos="fade-up"
  aria-roledescription="carousel"
  aria-label="Promociones y Colecciones Destacadas de ISOTELI"
>
  <div
    id="hero-carousel-container"
    class="relative w-full overflow-hidden select-none min-h-[580px] sm:min-h-[620px] md:min-h-[calc(100vh-152px)] h-[calc(100dvh-164px)] sm:h-[calc(100dvh-150px)] md:h-[calc(100dvh-152px)] group"
  >
    <!-- CONTENEDOR DE SLIDES TRANSICIONABLES -->
    <div class="relative w-full h-full flex">

      <!-- ===================================================================
           SLIDE 1: SERVICIO DE FLORERÍA ("NUESTROS DESTACADOS")
           =================================================================== -->
      <article
        data-hero-slide="0"
        class="hero-slide is-active w-full h-full flex-none transition-opacity duration-700 ease-in-out opacity-100 relative z-10 flex flex-col justify-between"
        aria-label="Slide 1 de 3: Nuestros Productos Destacados"
      >
        <!-- Imagen que ocupa el 100% del alto y ancho: Móvil (vertical) / Escritorio (horizontal) -->
        <picture class="absolute inset-0 w-full h-full z-0 pointer-events-none">
          <source media="(max-width: 767px)" srcset={verticalBannerCatalogoImg.src} />
          <source media="(min-width: 768px)" srcset={bannerCatalogoImg.src} />
          <img
            src={bannerCatalogoImg.src}
            alt="Colección botánica de rosas frescas y flores a domicilio en Arequipa - ISOTELI"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover object-center"
          />
        </picture>

        <!-- Degradado de contraste para legibilidad de textos centrados -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/60 sm:bg-black/40 sm:backdrop-blur-[0.5px] z-10 pointer-events-none"
          aria-hidden="true"
        ></div>

        <!-- Contenido Centrado del Slide -->
        <div class="relative z-20 w-full h-full max-w-4xl mx-auto px-margin-mobile md:px-margin py-8 sm:py-12 md:py-16 flex flex-col justify-between items-center text-center flex-1">
          <div class="flex flex-col items-center justify-center text-center gap-4 sm:gap-6 my-auto max-w-2xl">s
            <!-- Título y Subtítulo centrados con animación fade-up -->
            <div class="flex flex-col items-center gap-2 sm:gap-3 slide-fade-up anim-delay-2">
              <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white uppercase leading-tight drop-shadow-md">
                <span class="sr-only">Florería en Arequipa • Envíos a Domicilio - </span>
                NUESTROS DESTACADOS
              </h1>
              <p class="font-sans text-base sm:text-lg md:text-xl text-[#ffdad3] font-normal leading-relaxed drop-shadow-sm max-w-xl">
                Detalles que enamoran
              </p>
            </div>

            <!-- Botón CTA centrado con animación fade-down -->
            <div class="pt-2 sm:pt-4 flex items-center justify-center slide-fade-down anim-delay-3">
              <a
                href="/catalogo"
                class="inline-flex items-center justify-center gap-2 bg-[#500e05] hover:bg-[#6e2417] text-white border border-[#ffb4a6]/40 font-sans text-sm sm:text-base font-semibold px-8 py-3.5 rounded-full transition-all shadow-xl hover:shadow-2xl hover:scale-[1.03] active:scale-[0.98]"
              >
                <span>Ver catálogo</span>
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           SLIDE 2: SERVICIO DE DECORACIÓN DE EVENTOS ("DECORACIÓN DE EVENTOS")
           =================================================================== -->
      <article
        data-hero-slide="1"
        class="hero-slide w-full h-full flex-none transition-opacity duration-700 ease-in-out opacity-0 absolute inset-0 pointer-events-none z-0 flex flex-col justify-between"
        aria-label="Slide 2 de 3: Decoración de Eventos en Arequipa"
      >
        <!-- Imagen que ocupa el 100% del alto y ancho: Móvil (vertical) / Escritorio (horizontal) -->
        <picture class="absolute inset-0 w-full h-full z-0 pointer-events-none">
          <source media="(max-width: 767px)" srcset={verticalBannerDecoracionImg.src} />
          <source media="(min-width: 768px)" srcset={bannerDecoracionImg.src} />
          <img
            src={bannerDecoracionImg.src}
            alt="Montaje de decoración de evento con backing circular, globos, flores naturales y neón en Arequipa"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center"
          />
        </picture>

        <!-- Degradado de contraste para legibilidad de textos centrados -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/60 sm:bg-black/40 sm:backdrop-blur-[0.5px] z-10 pointer-events-none"
          aria-hidden="true"
        ></div>

        <!-- Contenido Centrado del Slide -->
        <div class="relative z-20 w-full h-full max-w-4xl mx-auto px-margin-mobile md:px-margin py-8 sm:py-12 md:py-16 flex flex-col justify-between items-center text-center flex-1">
          <div class="flex flex-col items-center justify-center text-center gap-4 sm:gap-6 my-auto max-w-2xl">
            <!-- Título y Subtítulo centrados con animación fade-up -->
            <div class="flex flex-col items-center gap-2 sm:gap-3 slide-fade-up anim-delay-1">
              <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white uppercase leading-tight drop-shadow-md">
                DECORACIÓN DE EVENTOS
              </h2>
              <p class="font-sans text-base sm:text-lg md:text-xl text-[#ffdad3] font-normal leading-relaxed drop-shadow-sm max-w-xl">
                Creamos momentos inolvidables
              </p>
            </div>

            <!-- Botón CTA centrado con animación fade-down -->
            <div class="pt-2 sm:pt-4 flex items-center justify-center slide-fade-down anim-delay-3">
              <a
                href="/eventos"
                class="inline-flex items-center justify-center gap-2 bg-white hover:bg-[#faf3ec] text-[#500e05] font-sans text-sm sm:text-base font-semibold px-8 py-3.5 rounded-full transition-all shadow-xl hover:shadow-2xl hover:scale-[1.03] active:scale-[0.98]"
              >
                <span>Ver Paquetes</span>
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>

        </div>
      </article>

      <!-- ===================================================================
           SLIDE 3: PROMOCIÓN DE FLORES ETERNAS ("FLORES ETERNAS")
           =================================================================== -->
      <article
        data-hero-slide="2"
        class="hero-slide w-full h-full flex-none transition-opacity duration-700 ease-in-out opacity-0 absolute inset-0 pointer-events-none z-0 flex flex-col justify-between"
        aria-label="Slide 3 de 3: Ramos de Flores Eternas hechas a mano"
      >
        <!-- Imagen que ocupa el 100% del alto y ancho: Móvil (vertical) / Escritorio (horizontal) -->
        <picture class="absolute inset-0 w-full h-full z-0 pointer-events-none">
          <source media="(max-width: 767px)" srcset={verticalBannerFloresEternasImg.src} />
          <source media="(min-width: 768px)" srcset={bannerFloresEternasImg.src} />
          <img
            src={bannerFloresEternasImg.src}
            alt="Ramos y creaciones de flores eternas hechas a mano con cinta de raso en Arequipa"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center"
          />
        </picture>

        <!-- Degradado de contraste para legibilidad de textos centrados -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/60 sm:bg-black/40 sm:backdrop-blur-[0.5px] z-10 pointer-events-none"
          aria-hidden="true"
        ></div>

        <!-- Contenido Centrado del Slide -->
        <div class="relative z-20 w-full h-full max-w-4xl mx-auto px-margin-mobile md:px-margin py-8 sm:py-12 md:py-16 flex flex-col justify-between items-center text-center flex-1">
          <div class="flex flex-col items-center justify-center text-center gap-4 sm:gap-6 my-auto max-w-2xl">
            <!-- Título y Subtítulo centrados con animación fade-up -->
            <div class="flex flex-col items-center gap-2 sm:gap-3 slide-fade-up anim-delay-1">
              <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight flex items-baseline justify-center gap-1 drop-shadow-md">                
                <span class="font-serif uppercase">Flores Eternas</span>
              </h2>
              <p class="font-sans text-base sm:text-lg md:text-xl text-[#ffdad3] font-normal leading-relaxed drop-shadow-sm max-w-xl">
                Hechas a mano con cinta de raso
              </p>
            </div>

            <!-- Botones CTA centrados con animación fade-down -->
            <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 pt-2 sm:pt-4 slide-fade-down anim-delay-3">
              <a
                href={buildWhatsAppUrl('Hola ISOTELI, deseo personalizar un ramo de Flores Eternas')}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-[#500e05] hover:bg-[#6e2417] text-white border border-[#ffb4a6]/40 font-sans text-sm sm:text-base font-semibold px-8 py-3.5 rounded-full transition-all shadow-xl hover:shadow-2xl hover:scale-[1.03] active:scale-[0.98]"
              >
                <span>Personalizar mi Ramo</span>
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>

        </div>
      </article>

    </div>

    <!-- INDICADORES INFERIORES INTERACTIVOS (DOTS) -->
    <div
      class="absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2.5"
      role="tablist"
      aria-label="Controles de navegación del carrusel"
    >
      <button
        type="button"
        data-hero-dot="0"
        role="tab"
        aria-selected="true"
        aria-label="Ver slide 1: Nuestros Destacados"
        class="hero-dot w-8 sm:w-10 h-2.5 rounded-full bg-white transition-all duration-300 cursor-pointer focus:outline-none shadow-md"
      ></button>
      <button
        type="button"
        data-hero-dot="1"
        role="tab"
        aria-selected="false"
        aria-label="Ver slide 2: Decoración de Eventos"
        class="hero-dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300 cursor-pointer focus:outline-none shadow-sm"
      ></button>
      <button
        type="button"
        data-hero-dot="2"
        role="tab"
        aria-selected="false"
        aria-label="Ver slide 3: Flores Eternas"
        class="hero-dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300 cursor-pointer focus:outline-none shadow-sm"
      ></button>
    </div>

    <!-- FLECHAS DE NAVEGACIÓN DISCRETAS -->
    <button
      type="button"
      id="hero-prev-btn"
      aria-label="Slide anterior"
      class="absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/35 hover:bg-black/60 text-white shadow-lg backdrop-blur-md border border-white/20 flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-105 active:scale-95 focus:opacity-100 cursor-pointer"
    >
      <span class="material-symbols-outlined text-[24px]" aria-hidden="true">chevron_left</span>
    </button>
    <button
      type="button"
      id="hero-next-btn"
      aria-label="Siguiente slide"
      class="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/35 hover:bg-black/60 text-white shadow-lg backdrop-blur-md border border-white/20 flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-105 active:scale-95 focus:opacity-100 cursor-pointer"
    >
      <span class="material-symbols-outlined text-[24px]" aria-hidden="true">chevron_right</span>
    </button>
  </div>
</section>

<!-- ================= ESTILOS DE ANIMACIÓN FADE UP Y FADE DOWN ================= -->
<style>
  /* Animación Fade Up para Textos e Insignias */
  .hero-slide .slide-fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .hero-slide.is-active .slide-fade-up {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animación Fade Down para Botones que Redirigen */
  .hero-slide .slide-fade-down {
    opacity: 0;
    transform: translateY(-24px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .hero-slide.is-active .slide-fade-down {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays secuenciales para una aparición armónica y elegante */
  .hero-slide.is-active .anim-delay-1 {
    transition-delay: 80ms;
  }
  .hero-slide.is-active .anim-delay-2 {
    transition-delay: 200ms;
  }
  .hero-slide.is-active .anim-delay-3 {
    transition-delay: 340ms;
  }
  .hero-slide.is-active .anim-delay-4 {
    transition-delay: 480ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide .slide-fade-up,
    .hero-slide .slide-fade-down {
      transform: none !important;
      transition-duration: 0.2s !important;
    }
  }
</style>

<!-- ================= SCRIPT DE INTERACTIVIDAD NATIVO ZERO-DEPENDENCY ================= -->
<script>
  function setupHeroCarousel(): void {
    const container = document.getElementById('hero-carousel-container');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('[data-hero-slide]');
    const dots = container.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');

    if (slides.length === 0) return;

    let current = 0;
    const total = slides.length;
    let timer: number | null = null;
    const AUTOPLAY_INTERVAL = 6000;

    function goToSlide(target: number): void {
      current = (target + total) % total;

      slides.forEach((slide, idx) => {
        if (idx === current) {
          slide.classList.remove('opacity-0', 'pointer-events-none', 'absolute', 'z-0', 'is-active');
          // Forzar reflujo DOM para que las animaciones de transición CSS se reinicien limpiamente en cada cambio
          void slide.offsetWidth;
          slide.classList.add('opacity-100', 'pointer-events-auto', 'relative', 'z-10', 'is-active');
        } else {
          slide.classList.remove('opacity-100', 'pointer-events-auto', 'relative', 'z-10', 'is-active');
          slide.classList.add('opacity-0', 'pointer-events-none', 'absolute', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        const isCurrent = idx === current;
        dot.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          dot.classList.remove('w-2.5', 'bg-white/40');
          dot.classList.add('w-8', 'sm:w-10', 'bg-white');
        } else {
          dot.classList.remove('w-8', 'sm:w-10', 'bg-white');
          dot.classList.add('w-2.5', 'bg-white/40');
        }
      });
    }

    function startAutoPlay(): void {
      stopAutoPlay();
      timer = window.setInterval(() => {
        goToSlide(current + 1);
      }, AUTOPLAY_INTERVAL);
    }

    function stopAutoPlay(): void {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Navegación con flechas
    prevBtn?.addEventListener('click', () => {
      goToSlide(current - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide(current + 1);
      startAutoPlay();
    });

    // Navegación con dots
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = Number(dot.dataset.heroDot || '0');
        goToSlide(targetIdx);
        startAutoPlay();
      });
    });

    // Pausar con hover o focus
    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);
    container.addEventListener('focusin', stopAutoPlay);
    container.addEventListener('focusout', startAutoPlay);

    // Navegación táctil (Swipe)
    let touchStartX = 0;
    container.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0]?.clientX || 0;
      },
      { passive: true }
    );

    container.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0]?.clientX || 0;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) {
            goToSlide(current + 1);
          } else {
            goToSlide(current - 1);
          }
          startAutoPlay();
        }
      },
      { passive: true }
    );

    // Iniciar reproducción automática
    startAutoPlay();
  }

  // Inicialización compatible con ciclo de vida Astro y navegación cliente
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroCarousel);
  } else {
    setupHeroCarousel();
  }

  document.addEventListener('astro:page-load', setupHeroCarousel);
</script>
