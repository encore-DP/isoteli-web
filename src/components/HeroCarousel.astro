            </div>

            <!-- Lista en Bullets de los 3 paquetes de decoración -->
            <ul class="flex flex-col gap-2.5 sm:gap-3 text-xs sm:text-sm text-[#402d29] leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-[#500e05] font-bold mt-0.5" aria-hidden="true">•</span>
                <span>
                  <strong class="font-bold text-[#500e05]">Pack Petit {petitPrice}</strong> — Backing de 1.5 m de ancho diseñado de forma personalizada
                </span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#500e05] font-bold mt-0.5" aria-hidden="true">•</span>
                <span>
                  <strong class="font-bold text-[#500e05]">Pack Gold {goldPrice}</strong> — Backing de 2.5 m de ancho con mobiliario y accesorios
                </span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#500e05] font-bold mt-0.5" aria-hidden="true">•</span>
                <span>
                  <strong class="font-bold text-[#500e05]">Pack Deluxe {deluxePrice}</strong> — Backing de 3 m de ancho completo para tu celebración
                </span>
              </li>
            </ul>

            <!-- Botón CTA único: Ver Paquetes -->
            <div class="pt-1">
              <a
                href="/servicios"
                class="inline-flex items-center justify-center bg-white/90 hover:bg-white text-[#500e05] border border-[#d8c2b5] font-sans text-xs sm:text-sm font-semibold px-6 sm:px-7 py-2.5 sm:py-3 rounded-full transition-all shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-[0.98]"
              >
                <span>Ver Paquetes</span>
              </a>
            </div>
          </div>

          <!-- Contacto Inferior Discreto con WhatsApp -->
          <div class="pt-3 sm:pt-4 flex items-center justify-start">
            <a
              href={buildWhatsAppUrl('Hola ISOTELI, quisiera cotizar la decoración para un evento')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-[#55423f] hover:text-[#500e05] font-medium transition-colors"
            >
              <WhatsAppIcon class="w-3.5 h-3.5 text-[#25D366]" />
              <span>{ISOTELI_CONTACT.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Ocupa todo el alto del slide y pegada al extremo derecho -->
        <div class="w-full lg:w-[44%] xl:w-[42%] h-52 sm:h-64 lg:h-auto shrink-0 relative lg:self-stretch overflow-hidden">
          <img
            src="/images/hero/slide2-decoracion.webp"
            alt="Montaje de decoración de evento con backing circular, globos, flores naturales y neón Feliz Cumpleaños en Arequipa"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center lg:rounded-l-[90px] xl:rounded-l-[110px]"
          />
        </div>
      </article>

      <!-- ===================================================================
           SLIDE 3: PROMOCIÓN DE FLORES ETERNAS ("FLORES ETERNAS")
           =================================================================== -->
      <article
        data-hero-slide="2"
        class="hero-slide w-full flex-none transition-opacity duration-700 ease-in-out opacity-0 absolute inset-0 pointer-events-none flex flex-col lg:flex-row justify-between items-stretch overflow-hidden min-h-[460px] sm:min-h-[400px] lg:min-h-[360px]"
        aria-label="Slide 3 de 3: Ramos de Flores Eternas hechas a mano"
      >
        <!-- Columna Izquierda con padding -->
        <div class="flex-1 p-6 sm:p-8 lg:p-10 flex flex-col justify-between z-10 max-w-xl">
          <div class="flex flex-col items-start gap-4 sm:gap-5">
            <div class="flex flex-col">
              <h2 class="text-2xl sm:text-3xl lg:text-4xl xl:text-[40px] font-bold tracking-tight text-[#500e05] leading-tight flex items-baseline gap-1">
                <span class="font-serif italic font-normal text-[1.12em] tracking-normal text-[#6e2417]">F</span>
                <span class="font-serif uppercase">lores Eternas</span>
              </h2>
              <p class="font-sans text-sm sm:text-base lg:text-lg text-[#55423f] font-normal mt-0.5">
                Hechas a mano con cinta de raso
              </p>
            </div>

            <!-- Descripción en bullets compactos -->
            <div class="flex flex-col gap-1.5 text-xs sm:text-sm text-[#402d29] leading-relaxed">
              <p class="font-semibold text-[#500e05]">
                Ramos y arreglos duraderos y personalizados
              </p>
              <div class="flex items-center gap-2">
                <span class="text-[#500e05] font-bold" aria-hidden="true">•</span>
                <span>El regalo perfecto que nunca se marchita</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#500e05] font-bold" aria-hidden="true">•</span>
                <span>Hechos con dedicación y amor</span>
              </div>
            </div>

            <!-- Botones CTA: Personalizar mi Ramo + Ver más -->
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a
                href={buildWhatsAppUrl('Hola ISOTELI, deseo personalizar un ramo de Flores Eternas')}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center bg-[#500e05] hover:bg-[#6e2417] text-white font-sans text-xs sm:text-sm font-semibold px-6 sm:px-7 py-2.5 sm:py-3 rounded-full transition-all shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-[0.98]"
              >
                <span>Personalizar mi Ramo</span>
              </a>

              <a
                href="/catalogo"
                class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-[#500e05] hover:text-[#6e2417] px-3 py-2 transition-colors hover:underline underline-offset-4"
              >
                <span>Ver más</span>
                <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>

          <!-- Contacto Inferior Discreto con WhatsApp -->
          <div class="pt-3 sm:pt-4 flex items-center justify-start">
            <a
              href={buildWhatsAppUrl('Hola ISOTELI, deseo consultar por un ramo de flores eternas')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-[#55423f] hover:text-[#500e05] font-medium transition-colors"
            >
              <WhatsAppIcon class="w-3.5 h-3.5 text-[#25D366]" />
              <span>{ISOTELI_CONTACT.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Ocupa todo el alto del slide y pegada al extremo derecho -->
        <div class="w-full lg:w-[46%] xl:w-[44%] h-52 sm:h-64 lg:h-auto shrink-0 relative lg:self-stretch overflow-hidden">
          <img
            src="/images/hero/slide3-flores-eternas.webp"
            alt="Ramos de flores eternas hechas a mano con cinta de raso en tonos rosa, crema y rojo con luces LED en Arequipa"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center lg:rounded-l-[90px] xl:rounded-l-[110px]"
          />
        </div>
      </article>
    </div>

    <!-- 4. INDICADORES INFERIORES INTERACTIVOS (DOTS) -->
    <div
      class="absolute bottom-3.5 sm:bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2"
      role="tablist"
      aria-label="Controles de navegación del carrusel"
    >
      <button
        type="button"
        data-hero-dot="0"
        role="tab"
        aria-selected="true"
        aria-label="Ver slide 1: Nuestros Destacados"
        class="hero-dot w-8 h-2 sm:h-2.5 rounded-full bg-[#500e05] transition-all duration-300 cursor-pointer focus:outline-none"
      ></button>
      <button
        type="button"
        data-hero-dot="1"
        role="tab"
        aria-selected="false"
        aria-label="Ver slide 2: Decoración de Eventos"
        class="hero-dot w-2 sm:w-2.5 h-2 sm:h-2.5 rounded-full bg-[#500e05]/30 hover:bg-[#500e05]/60 transition-all duration-300 cursor-pointer focus:outline-none"
      ></button>
      <button
        type="button"
        data-hero-dot="2"
        role="tab"
        aria-selected="false"
        aria-label="Ver slide 3: Flores Eternas"
        class="hero-dot w-2 sm:w-2.5 h-2 sm:h-2.5 rounded-full bg-[#500e05]/30 hover:bg-[#500e05]/60 transition-all duration-300 cursor-pointer focus:outline-none"
      ></button>
    </div>

    <!-- 5. FLECHAS DE NAVEGACIÓN DISCRETAS -->
    <button
      type="button"
      id="hero-prev-btn"
      aria-label="Slide anterior"
      class="absolute left-2.5 sm:left-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/80 hover:bg-white text-[#500e05] shadow-sm backdrop-blur-sm flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-105 active:scale-95 focus:opacity-100 cursor-pointer"
    >
      <span class="material-symbols-outlined text-[20px] sm:text-[22px]" aria-hidden="true">chevron_left</span>
    </button>
    <button
      type="button"
      id="hero-next-btn"
      aria-label="Siguiente slide"
      class="absolute right-2.5 sm:right-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/80 hover:bg-white text-[#500e05] shadow-sm backdrop-blur-sm flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-105 active:scale-95 focus:opacity-100 cursor-pointer"
    >
      <span class="material-symbols-outlined text-[20px] sm:text-[22px]" aria-hidden="true">chevron_right</span>
    </button>
  </div>
</section>

<!-- ================= SCRIPT DE INTERACTIVIDAD NATIVO ZERO-DEPENDENCY ================= -->
<script>
  function setupHeroCarousel(): void {
    const container = document.getElementById('hero-carousel-container');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('[data-hero-slide]');
    const dots = container.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');

    if (slides.length === 0) return;

    let current = 0;
    const total = slides.length;
    let timer: number | null = null;
    const AUTOPLAY_INTERVAL = 6000;

    function goToSlide(target: number): void {
      current = (target + total) % total;

      slides.forEach((slide, idx) => {
        if (idx === current) {
          slide.classList.remove('opacity-0', 'pointer-events-none', 'absolute', 'z-0');
          slide.classList.add('opacity-100', 'pointer-events-auto', 'relative', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'pointer-events-auto', 'relative', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none', 'absolute', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        const isCurrent = idx === current;
        dot.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          dot.classList.remove('w-2', 'sm:w-2.5', 'bg-[#500e05]/30');
          dot.classList.add('w-8', 'bg-[#500e05]');
        } else {
          dot.classList.remove('w-8', 'bg-[#500e05]');
          dot.classList.add('w-2', 'sm:w-2.5', 'bg-[#500e05]/30');
        }
      });
    }

    function startAutoPlay(): void {
      stopAutoPlay();
      timer = window.setInterval(() => {
        goToSlide(current + 1);
      }, AUTOPLAY_INTERVAL);
    }

    function stopAutoPlay(): void {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Navegación con flechas
    prevBtn?.addEventListener('click', () => {
      goToSlide(current - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide(current + 1);
      startAutoPlay();
    });

    // Navegación con dots
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = Number(dot.dataset.heroDot || '0');
        goToSlide(targetIdx);
        startAutoPlay();
      });
    });

    // Pausar con hover o focus
    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);
    container.addEventListener('focusin', stopAutoPlay);
    container.addEventListener('focusout', startAutoPlay);

    // Navegación táctil (Swipe)
    let touchStartX = 0;
    container.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0]?.clientX || 0;
      },
      { passive: true }
    );

    container.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0]?.clientX || 0;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) {
            goToSlide(current + 1);
          } else {
            goToSlide(current - 1);
          }
          startAutoPlay();
        }
      },
      { passive: true }
    );

    // Iniciar reproducción automática
    startAutoPlay();
  }

  // Inicialización compatible con ciclo de vida Astro y navegación cliente
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroCarousel);
  } else {
    setupHeroCarousel();
  }

  document.addEventListener('astro:page-load', setupHeroCarousel);
</script>

