---
import { ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import { PLACEHOLDER_IMAGE } from '../data/fallback-store';
import type { CatalogProduct } from '../lib/wp-graphql';
import WhatsAppIcon from './WhatsAppIcon.astro';

export interface Props {
  product: CatalogProduct;
  variant?: 'catalog' | 'featured';
}

const { product, variant = 'catalog' } = Astro.props;

const defaultVariation =
  product.productType === 'variable' && product.variations.length > 0
    ? (product.variations.find((v) => v.badge) ?? product.variations[0]!)
    : null;

const initialPriceText = defaultVariation
  ? defaultVariation.formattedPrice
  : product.pricePrefix
    ? `${product.pricePrefix} ${product.formattedPrice}`
    : product.formattedPrice;

const initialNumericPrice = defaultVariation ? defaultVariation.numericPrice : product.numericPrice;

const initialWhatsAppMessage = defaultVariation
  ? `Hola ISOTELI, deseo ordenar el producto: ${product.name} - Opción: ${defaultVariation.label} (${defaultVariation.formattedPrice})`
  : `Hola ISOTELI, deseo ordenar el producto: ${product.name} (${product.formattedPrice})`;

const whatsappUrl = buildWhatsAppUrl(initialWhatsAppMessage);
const productHref = `/producto/${product.slug}`;
const safeImage = product.imageUrl || PLACEHOLDER_IMAGE;

// Detección de paleta de colores para filtro dinámico
function extractColors(text: string): string[] {
  const t = text.toLowerCase();
  const colors: string[] = [];
  if (/rojo|roja|amor|pasi[oó]n|fresas|deluxe|san valent[ií]n/.test(t)) colors.push('rojo');
  if (/rosa|rosad|pastel|princesa|tierno|amorosa|encapsulado/.test(t)) colors.push('rosado');
  if (/blanco|blanca|lirio|pureza|margarita|orqu[ií]dea|cl[aá]sico/.test(t)) colors.push('blanco');
  if (/amarillo|girasol|sol|rayo|alegr[ií]a|vibrante/.test(t)) colors.push('amarillo');
  if (/naranja|durazno|oto[nñ]o|melocot[oó]n|tulip[aá]n/.test(t)) colors.push('naranja');
  if (/lila|morado|violeta|lavanda|sutil/.test(t)) colors.push('lila');

  if (colors.length === 0) {
    if (t.includes('globo') || t.includes('parante')) {
      colors.push('blanco', 'rosado');
    } else {
      colors.push('rosado', 'rojo');
    }
  }
  return colors;
}

// Detección de tipos de flor para filtro dinámico
function extractFlowerTypes(prod: CatalogProduct): string[] {
  const t = `${prod.name} ${prod.shortDescription} ${prod.categoryLabel}`.toLowerCase();
  const types: string[] = [];
  if (/rosa/.test(t)) types.push('rosas');
  if (/girasol/.test(t)) types.push('girasoles');
  if (/eterna|eterno/.test(t)) types.push('eternas');
  if (/tulip[aá]n/.test(t)) types.push('tulipanes');
  if (/orqu[ií]dea/.test(t)) types.push('orquideas');
  if (/hortensia/.test(t)) types.push('hortensias');
  if (/clavel/.test(t)) types.push('claveles');
  if (/gerbera/.test(t)) types.push('gerberas');
  if (/caja|box/.test(t)) types.push('cajas-y-boxes');
  if (/globo|bouquet|parante/.test(t)) types.push('globos-y-bouquets');
  return types;
}

const productColors = extractColors(`${product.name} ${product.shortDescription} ${product.categoryLabel}`);
const productFlowerTypes = extractFlowerTypes(product);
---

{
  variant === 'catalog' ? (
    <article
      class="product-item group flex flex-col bg-white rounded-2xl p-3 sm:p-4 border border-[#ECD9CC]/70 shadow-2xs hover:shadow-md transition-all duration-300"
      data-category={product.categorySlug}
      data-colors={productColors.join(',')}
      data-flower-types={productFlowerTypes.join(',')}
      data-popularity={String(product.popularity)}
      data-price={String(initialNumericPrice)}
      data-title={`${product.name} ${product.shortDescription} ${product.categoryLabel}`}
      data-product-name={product.name}
      data-whatsapp-phone={ISOTELI_CONTACT.phoneRaw}
    >
      <!-- Fotografía del producto con esquinas redondeadas -->
      <a
        href={productHref}
        class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-[#FAF4EE] block group-hover:opacity-95 transition-opacity"
        aria-label={`Ver detalles de ${product.name}`}
      >
        <img
          src={safeImage}
          alt={product.imageAlt}
          loading="lazy"
          decoding="async"
          onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />

        {product.badge && (
          <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#500e05] text-white shadow-2xs">
            {product.badge}
          </span>
        )}
      </a>

      <!-- Cuerpo de la tarjeta: Título con sus variantes de presentación (sin descripción corta) -->
      <div class="flex flex-col flex-1 justify-between pt-3">
        <div>
          <!-- Título del producto -->
          <h3 class="font-sans font-bold text-sm sm:text-base text-[#1b1c16] group-hover:text-[#500e05] transition-colors leading-snug line-clamp-2">
            <a href={productHref} class="hover:underline focus:outline-none">
              {product.name}
            </a>
          </h3>

          <!-- Variantes de presentación -->
          {product.productType === 'variable' && product.variations.length > 0 && (
            <div class="mt-2.5 pt-2 border-t border-[#ECD9CC]/60">
              <span class="text-[10px] uppercase tracking-wider text-[#88726e] font-semibold block mb-1.5">
                Elige presentación:
              </span>
              <div class="flex flex-wrap gap-1.5" role="group" aria-label={`Opciones de ${product.name}`}>
                {product.variations.map((v) => {
                  const isDefault = defaultVariation?.id === v.id;
                  return (
                    <button
                      type="button"
                      data-var-btn
                      data-var-label={v.label}
                      data-var-price={v.formattedPrice}
                      data-var-numeric={String(v.numericPrice)}
                      class:list={[
                        'px-2.5 py-1 rounded-full text-[11px] font-medium transition-colors cursor-pointer border',
                        isDefault
                          ? 'bg-[#500e05] text-white border-[#500e05] font-semibold'
                          : 'bg-[#FAF4EE] text-[#55423f] border-[#ECD9CC] hover:bg-[#ECD9CC]/50',
                      ]}
                    >
                      {v.label} · {v.formattedPrice}
                    </button>
                  );
                })}
              </div>
            </div>
          )}
        </div>

        <!-- Pie de Tarjeta: Precio y Botón 'Pedir por WhatsApp' -->
        <div class="mt-3 pt-2.5 border-t border-[#ECD9CC]/60 flex flex-col gap-2.5">
          <div class="flex items-baseline justify-between">
            <span data-card-price class="font-bold text-lg sm:text-xl text-[#500e05]">
              {initialPriceText}
            </span>
          </div>

          <a
            data-card-wa-link
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-full bg-[#500e05] hover:bg-[#6e2417] text-white font-sans font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-2 transition-all shadow-sm hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
          >
            <WhatsAppIcon class="w-4 h-4 text-white" />
            <span class="text-white">Pedir por WhatsApp</span>
          </a>
        </div>
      </div>
    </article>
  ) : (
    <article
      class="product-item group flex flex-col bg-surface-container-lowest overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-outline-variant/40 rounded-3xl p-4"
      data-aos="fade-up"
      data-category={product.categorySlug}
      data-popularity={String(product.popularity)}
      data-price={String(initialNumericPrice)}
      data-title={`${product.name} ${product.shortDescription} ${product.categoryLabel}`}
      data-product-name={product.name}
      data-whatsapp-phone={ISOTELI_CONTACT.phoneRaw}
    >
      <a
        href={productHref}
        class="relative w-full bg-surface-container overflow-hidden block aspect-[4/4.5] rounded-2xl mb-4"
        aria-label={`Ver detalles de ${product.name}`}
      >
        <img
          src={safeImage}
          alt={product.imageAlt}
          loading="lazy"
          decoding="async"
          onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE}';`}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />

        {product.badge && (
          <div class="absolute top-3 left-3 flex gap-2">
            <span class="px-3 py-1 rounded-full font-label-md text-label-md uppercase tracking-wider shadow-sm bg-primary text-on-primary">
              {product.badge}
            </span>
          </div>
        )}

        <span
          class="absolute bottom-3 right-3 w-9 h-9 rounded-full bg-secondary-container/95 text-secondary flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform"
          aria-hidden="true"
        >
          <span class="material-symbols-outlined text-[18px]">favorite</span>
        </span>
      </a>

      <div class="flex flex-col flex-1 justify-between gap-space-sm">
        <div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold">
              {product.categoryLabel}
            </span>
            <span class="font-body-sm text-body-sm text-on-surface flex items-center gap-1">
              <span class="material-symbols-outlined icon-filled text-[14px] text-primary" aria-hidden="true">star</span>
              {product.rating.toFixed(1)} ({product.reviewCount})
            </span>
          </div>

          <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface group-hover:text-primary transition-colors mb-1">
            <a href={productHref} class="hover:underline focus:outline-none">
              {product.name}
            </a>
          </h3>

          <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">
            {product.shortDescription}
          </p>

          {product.productType === 'variable' && product.variations.length > 0 && (
            <div class="mt-3 pt-2.5 border-t border-surface-container">
              <span class="font-label-md text-[10px] uppercase tracking-wider text-outline block mb-1.5">
                Elige presentación:
              </span>
              <div class="flex flex-wrap gap-1.5" role="group" aria-label={`Opciones de ${product.name}`}>
                {product.variations.map((v) => {
                  const isDefault = defaultVariation?.id === v.id;
                  return (
                    <button
                      type="button"
                      data-var-btn
                      data-var-label={v.label}
                      data-var-price={v.formattedPrice}
                      data-var-numeric={String(v.numericPrice)}
                      class:list={[
                        'px-2.5 py-1 rounded-full text-[11px] font-medium transition-colors cursor-pointer border',
                        isDefault
                          ? 'bg-[#500e05] text-white border-[#500e05] font-semibold'
                          : 'bg-surface-container-low text-on-surface-variant border-outline-variant/40 hover:bg-surface-container',
                      ]}
                    >
                      {v.label} · {v.formattedPrice}
                    </button>
                  );
                })}
              </div>
            </div>
          )}
        </div>

        <div class="pt-3 border-t border-surface-container flex items-center justify-between gap-space-sm">
          <div class="flex flex-col">
            <span data-card-price class="font-headline text-2xl font-bold text-primary">
              {initialPriceText}
            </span>
          </div>

          <a
            data-card-wa-link
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-container text-on-primary px-4 py-2.5 rounded-full font-label-md text-label-md tracking-wider transition-all shadow-sm hover:scale-[1.02]"
          >
            <WhatsAppIcon class="w-4 h-4 text-white" />
            <span class="text-white">Pedir por WhatsApp</span>
          </a>
        </div>
      </div>
    </article>
  )
}

<script>
  // Inicializa la selección interactiva de variaciones en tarjetas de VariableProduct
  document.querySelectorAll<HTMLElement>('article.product-item').forEach((card) => {
    if (card.dataset.varBound === 'true') return;
    card.dataset.varBound = 'true';

    const varBtns = card.querySelectorAll<HTMLButtonElement>('[data-var-btn]');
    if (varBtns.length === 0) return;

    const priceEl = card.querySelector<HTMLElement>('[data-card-price]');
    const waLink = card.querySelector<HTMLAnchorElement>('[data-card-wa-link]');
    const productName = card.dataset.productName || 'Arreglo ISOTELI';
    const phone = card.dataset.whatsappPhone || '51904803219';

    varBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        varBtns.forEach((b) => {
          b.classList.remove('bg-[#500e05]', 'text-white', 'border-[#500e05]', 'bg-primary-fixed', 'text-primary', 'border-primary/40', 'font-semibold');
          b.classList.add('bg-[#FAF4EE]', 'text-[#55423f]', 'border-[#ECD9CC]', 'bg-surface-container-low', 'text-on-surface-variant', 'border-outline-variant/40');
        });

        btn.classList.add('bg-[#500e05]', 'text-white', 'border-[#500e05]', 'font-semibold');
        btn.classList.remove('bg-[#FAF4EE]', 'text-[#55423f]', 'border-[#ECD9CC]', 'bg-surface-container-low', 'text-on-surface-variant', 'border-outline-variant/40');

        const varLabel = btn.dataset.varLabel || '';
        const varPrice = btn.dataset.varPrice || '';
        const varNumeric = btn.dataset.varNumeric || '0';

        if (priceEl && varPrice) {
          priceEl.textContent = varPrice;
        }
        card.setAttribute('data-price', varNumeric);

        if (waLink) {
          const message = `Hola ISOTELI, deseo ordenar el producto: ${productName} - Opción: ${varLabel} (${varPrice})`;
          waLink.href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
        }
      });
    });
  });
</script>
