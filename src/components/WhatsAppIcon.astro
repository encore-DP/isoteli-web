---
export interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = 'w-4 h-4', size } = Astro.props;
const inlineStyle = size
  ? `width: ${typeof size === 'number' ? `${size}px` : size}; height: ${typeof size === 'number' ? `${size}px` : size};`
  : undefined;
