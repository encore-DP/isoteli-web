---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo/logo.png';
import { ISOTELI_CONTACT, buildWhatsAppUrl } from '../data/business';
import WhatsAppIcon from './WhatsAppIcon.astro';

const currentYear = new Date().getFullYear();
const footerWhatsappUrl = buildWhatsAppUrl('Hola ISOTELI, deseo realizar una consulta sobre sus arreglos o eventos.');
---

<!-- ================= PIE DE PÁGINA INSTITUCIONAL (FOOTER) ================= -->
<footer class="w-full bg-surface-container-low text-on-surface pt-space-xl pb-space-lg border-t border-outline-variant/40" data-aos="fade-up">
  <div class="w-full px-margin-mobile md:px-margin">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-space-xl">
      <!-- Columna 1: Identidad de Marca, Tienda 100% Virtual y Oficina de Coordinación -->
      <div class="flex flex-col gap-space-sm">
        <div class="flex items-center gap-space-xs">
          <a href="/" class="flex items-center" aria-label="Inicio ISOTELI">
            <Image
              src={logoImg}
              alt="Logotipo ISOTELI Flores y Detalles"
              width={130}
              height={91}
              class="h-25 w-auto object-contain"
            />
          </a>
        </div>
      </div>

      <!-- Columna 2: Correos Oficiales y Métodos de Pago -->
      <div class="flex flex-col gap-space-xs">
        <p class="font-headline-sm text-headline-sm text-primary font-semibold mb-space-xs">
          Contacto &amp; Métodos de Pago
        </p>
        <ul class="flex flex-col gap-2 font-body-md text-body-md text-on-surface-variant">
          <li>
            <a
              class="hover:text-primary transition-colors flex items-center gap-2"
              href={`mailto:${ISOTELI_CONTACT.emails.ventas}`}
            >
              <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">mail</span>
              <span>{ISOTELI_CONTACT.emails.ventas}</span>
            </a>
          </li>
        </ul>
        <div class="mt-2 pt-3 border-t border-outline-variant/30">
          <p class="font-label-md text-label-md uppercase text-primary mb-1 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[15px]" aria-hidden="true">payments</span>
            <span>Métodos de Pago</span>
          </p>
          <p class="font-body-sm text-body-sm text-on-surface-variant">
            Transferencia bancaria, Tarjeta de Credito/Debito <strong class="text-on-surface">Yape</strong> y <strong class="text-on-surface">Plin</strong>.
          </p>
        </div>
      </div>

      <!-- Columna 3: Navegación Rápida de Catálogo y Servicios -->
      <div class="flex flex-col gap-space-xs">
        <p class="font-headline-sm text-headline-sm text-primary font-semibold mb-space-xs">
          Catálogo &amp; Servicios
        </p>
        <ul class="flex flex-col gap-2 font-body-md text-body-md text-on-surface-variant">
          <li>
            <a class="hover:text-primary transition-colors" href="/catalogo">
              Ramos de Rosas &amp; Ramos Buchones
            </a>
          </li>
          <li>
            <a class="hover:text-primary transition-colors" href="/catalogo">
              Cajas ISOTELI, Girasoles &amp; Boxes Mixtos
            </a>
          </li>
          <li>
            <a class="hover:text-primary transition-colors" href="/catalogo">
              Globos, Chocolates La Ibérica &amp; Peluches
            </a>
          </li>
          <li>
            <a class="hover:text-primary transition-colors" href="/servicios#paquetes-decoracion">
              Paquetes de Decoración (Clásicos &amp; Temáticos)
            </a>
          </li>
          <li>
            <a class="hover:text-primary transition-colors" href="/servicios#alquiler-mobiliario">
              Alquiler de Mobiliario y Accesorios
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Horarios, Políticas de Envío y Comunidad -->
      <div class="flex flex-col gap-space-xs">
        <p class="font-headline-sm text-headline-sm text-primary font-semibold mb-space-xs">
          Atención &amp; Envíos
        </p>
        <div class="font-body-sm text-body-sm text-on-surface-variant flex flex-col gap-2 mb-space-sm">
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5" aria-hidden="true">schedule</span>
            <div>
              <p class="font-semibold text-on-surface">{ISOTELI_CONTACT.schedule.weekdays}</p>
              <p>{ISOTELI_CONTACT.schedule.sundays}</p>
            </div>
          </div>
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5" aria-hidden="true">timer</span>
            <p>
              <span class="font-semibold text-on-surface">Anticipación:</span> {ISOTELI_CONTACT.schedule.leadTime}
            </p>
          </div>
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5" aria-hidden="true">local_shipping</span>
            <p>{ISOTELI_CONTACT.deliveryPolicy.topBarText}</p>
          </div>
          <div class="flex items-start gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5" aria-hidden="true">location_on</span>
            <span>
              Ubicación para recojos: <strong class="text-on-surface">{ISOTELI_CONTACT.officeShortAddress}</strong>
            </span>
          </div>
          

        </div>

        <div class="flex items-center gap-space-xs">
          <a
            aria-label="Instagram oficial de ISOTELI"
            class="w-9 h-9 rounded-full bg-surface-container-highest flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-on-primary transition-colors"
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">photo_camera</span>
          </a>
          <a
            aria-label="WhatsApp oficial de ISOTELI"
            class="w-9 h-9 rounded-full bg-surface-container-highest flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-on-primary transition-colors"
            href={footerWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <WhatsAppIcon class="w-[18px] h-[18px]" />
          </a>
          <a
            aria-label="Ubicación de oficina en Google Maps"
            class="w-9 h-9 rounded-full bg-surface-container-highest flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-on-primary transition-colors"
            href={ISOTELI_CONTACT.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">pin_drop</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra Inferior de Derechos Reservados y Enlaces Institucionales -->
    <div class="pt-space-md border-t border-outline-variant/30 flex flex-col items-center justify-center gap-3 font-body-sm text-body-sm text-on-surface-variant text-center pb-12 sm:pb-6">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a class="hover:text-primary transition-colors py-1" href="/nosotros#cobertura-distrital">
          Cobertura &amp; Límites Distritales
        </a>
        <span class="hidden sm:inline text-outline-variant/60" aria-hidden="true">•</span>
        <a class="hover:text-primary transition-colors py-1" href="/contacto">
          Atención al Cliente
        </a>
        <span class="hidden sm:inline text-outline-variant/60" aria-hidden="true">•</span>
        <a class="hover:text-primary transition-colors inline-flex items-center gap-1.5 font-medium text-primary hover:underline py-1" href="/libro-de-reclamaciones">
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">menu_book</span>
          <span>Libro de Reclamaciones</span>
        </a>
      </div>
      <p class="text-xs text-on-surface-variant/80">
        © {currentYear} ISOTELI Flores y Detalles. Todos los derechos reservados. Arequipa, Perú.
      </p>
    </div>
  </div>
</footer>

